<mxfile host="Claude" type="device">
  <diagram id="pag0" name="1 · Dos formas de usar el sistema">
    <mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="660" math="0" shadow="0">
      <root>
        <mxCell id="p0-0"/>
        <mxCell id="p0-1" parent="p0-0"/>
        <mxCell id="n1" value="1 · Dos formas de usar el sistema" style="text;html=1;fontSize=26;fontStyle=1;fontColor=#1f2933;align=left;" vertex="1" parent="p0-1"><mxGeometry x="60" y="30" width="1380" height="34" as="geometry"/></mxCell>
        <mxCell id="n2" value="Este manual tiene dos partes: cómo registrar un territorio por WhatsApp (para la comunidad),
        y cómo revisar y administrar esa información en el visor (para Katherine)." style="text;html=1;whiteSpace=wrap;fontSize=13;fontColor=#5b6470;align=left;" vertex="1" parent="p0-1"><mxGeometry x="60" y="68" width="1380" height="40" as="geometry"/></mxCell>
        <mxCell id="g1_comunidad" value="Comunidad
        étnica" style="shape=actor;html=1;fillColor=#fbeae8;strokeColor=#c0392b;strokeWidth=1.5;fontColor=#1f2933;fontStyle=1;fontSize=12;whiteSpace=wrap;verticalLabelPosition=bottom;verticalAlign=top;labelPosition=center;" vertex="1" parent="p0-1"><mxGeometry x="140" y="190" width="90" height="90" as="geometry"/></mxCell>
        <mxCell id="g1_kath" value="Katherine" style="shape=actor;html=1;fillColor=#fbeae8;strokeColor=#c0392b;strokeWidth=1.5;fontColor=#1f2933;fontStyle=1;fontSize=12;whiteSpace=wrap;verticalLabelPosition=bottom;verticalAlign=top;labelPosition=center;" vertex="1" parent="p0-1"><mxGeometry x="1270" y="190" width="90" height="90" as="geometry"/></mxCell>
        <mxCell id="g1_wa" value="Por WhatsApp, desde el celular
        
        Capítulos 2 a 7 de este manual" style="rounded=0;html=1;fillColor=#e6f4f1;strokeColor=#0f766e;strokeWidth=1.5;fontColor=#1f2933;align=center;fontSize=12;fontStyle=1;whiteSpace=wrap;spacing=8;" vertex="1" parent="p0-1"><mxGeometry x="260" y="190" width="380" height="110" as="geometry"/></mxCell>
        <mxCell id="g1_geo" value="Por el navegador, en el visor
        
        Capítulos 8 a 18 de este manual" style="rounded=0;html=1;fillColor=#eaf1fa;strokeColor=#2f6fb0;strokeWidth=1.5;fontColor=#1f2933;align=center;fontSize=12;fontStyle=1;whiteSpace=wrap;spacing=8;" vertex="1" parent="p0-1"><mxGeometry x="890" y="190" width="380" height="110" as="geometry"/></mxCell>
        <mxCell id="g1_bd" value="La misma información,
        en un solo lugar" style="shape=cylinder3;html=1;boundedLbl=1;fillColor=#199e70;strokeColor=#199e70;fontColor=#ffffff;fontStyle=1;fontSize=12;whiteSpace=wrap;" vertex="1" parent="p0-1"><mxGeometry x="640" y="400" width="220" height="90" as="geometry"/></mxCell>
        <mxCell id="n3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;fontColor=#3a3f44;labelBackgroundColor=#ffffff;strokeColor=#0f766e;strokeWidth=1.6;endArrow=block;endFill=1;endSize=8;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;jumpStyle=arc;jumpSize=8;" edge="1" parent="p0-1" source="g1_comunidad" target="g1_wa"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="n4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;fontColor=#3a3f44;labelBackgroundColor=#ffffff;strokeColor=#2f6fb0;strokeWidth=1.6;endArrow=block;endFill=1;endSize=8;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;jumpStyle=arc;jumpSize=8;" edge="1" parent="p0-1" source="g1_kath" target="g1_geo"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="n5" value="registra" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;fontColor=#3a3f44;labelBackgroundColor=#ffffff;strokeColor=#0f766e;strokeWidth=1.6;endArrow=block;endFill=1;endSize=8;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.15;entryY=0;entryDx=0;entryDy=0;jumpStyle=arc;jumpSize=8;" edge="1" parent="p0-1" source="g1_wa" target="g1_bd"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="n6" value="consulta" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;fontColor=#3a3f44;labelBackgroundColor=#ffffff;strokeColor=#2f6fb0;strokeWidth=1.6;endArrow=block;endFill=1;endSize=8;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.85;entryY=0;entryDx=0;entryDy=0;jumpStyle=arc;jumpSize=8;" edge="1" parent="p0-1" source="g1_geo" target="g1_bd"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="g1_n1" value="El capítulo 19, al final, reúne preguntas frecuentes y qué hacer cuando algo no funciona como se espera —
        sirve tanto para la comunidad como para Katherine." style="shape=note;size=14;html=1;fillColor=#eef0f2;strokeColor=#5b6470;fontColor=#1f2933;fontSize=10;whiteSpace=wrap;align=left;spacing=6;" vertex="1" parent="p0-1"><mxGeometry x="60" y="540" width="1380" height="90" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="pag1" name="2 · Antes de empezar">
    <mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="p1-0"/>
        <mxCell id="p1-1" parent="p1-0"/>
        <mxCell id="n7" value="2 · Antes de empezar" style="text;html=1;fontSize=26;fontStyle=1;fontColor=#1f2933;align=left;" vertex="1" parent="p1-1"><mxGeometry x="60" y="30" width="1380" height="34" as="geometry"/></mxCell>
        <mxCell id="n8" value="Esto es todo lo que necesitas para registrar tu territorio por WhatsApp. No hay que instalar
        nada nuevo ni crear ninguna cuenta." style="text;html=1;whiteSpace=wrap;fontSize=13;fontColor=#5b6470;align=left;" vertex="1" parent="p1-1"><mxGeometry x="60" y="68" width="1380" height="40" as="geometry"/></mxCell>
        <mxCell id="g2_c0" value="&lt;b&gt;Un celular con WhatsApp&lt;/b&gt;&lt;br&gt;&lt;br&gt;El mismo WhatsApp que usas para hablar con tu familia — no se necesita otra aplicación." style="rounded=0;html=1;fillColor=#e6f4f1;strokeColor=#0f766e;strokeWidth=1.5;fontColor=#1f2933;align=left;fontSize=12;whiteSpace=wrap;spacing=8;" vertex="1" parent="p1-1"><mxGeometry x="60" y="150" width="440" height="150" as="geometry"/></mxCell>
        <mxCell id="g2_c1" value="&lt;b&gt;El número del chatbot&lt;/b&gt;&lt;br&gt;&lt;br&gt;Guárdalo en tus contactos, como a cualquier otra persona, para poder escribirle." style="rounded=0;html=1;fillColor=#e6f4f1;strokeColor=#0f766e;strokeWidth=1.5;fontColor=#1f2933;align=left;fontSize=12;whiteSpace=wrap;spacing=8;" vertex="1" parent="p1-1"><mxGeometry x="540" y="150" width="440" height="150" as="geometry"/></mxCell>
        <mxCell id="g2_c2" value="&lt;b&gt;Estar en el territorio, o tener claro su recorrido&lt;/b&gt;&lt;br&gt;&lt;br&gt;En algún momento el bot te va a pedir compartir la ubicación por GPS y describir el perímetro." style="rounded=0;html=1;fillColor=#e6f4f1;strokeColor=#0f766e;strokeWidth=1.5;fontColor=#1f2933;align=left;fontSize=12;whiteSpace=wrap;spacing=8;" vertex="1" parent="p1-1"><mxGeometry x="1020" y="150" width="440" height="150" as="geometry"/></mxCell>
        <mxCell id="g2_c3" value="&lt;b&gt;Un poco de tiempo&lt;/b&gt;&lt;br&gt;&lt;br&gt;El registro completo de un territorio toma entre 15 y 30 minutos. Puedes responder por partes y seguir después." style="rounded=0;html=1;fillColor=#e6f4f1;strokeColor=#0f766e;strokeWidth=1.5;fontColor=#1f2933;align=left;fontSize=12;whiteSpace=wrap;spacing=8;" vertex="1" parent="p1-1"><mxGeometry x="60" y="330" width="440" height="150" as="geometry"/></mxCell>
        <mxCell id="g2_c4" value="&lt;b&gt;Ser una persona autorizada para hablar por la comunidad&lt;/b&gt;&lt;br&gt;&lt;br&gt;Alguien reconocido por las autoridades propias o por la asamblea — el bot pregunta esto al empezar." style="rounded=0;html=1;fillColor=#e6f4f1;strokeColor=#0f766e;strokeWidth=1.5;fontColor=#1f2933;align=left;fontSize=12;whiteSpace=wrap;spacing=8;" vertex="1" parent="p1-1"><mxGeometry x="540" y="330" width="440" height="150" as="geometry"/></mxCell>
        <mxCell id="g2_c5" value="&lt;b&gt;Fotos o notas de voz (opcional)&lt;/b&gt;&lt;br&gt;&lt;br&gt;Si quieres, puedes enviar fotos del territorio o responder hablando en vez de escribiendo." style="rounded=0;html=1;fillColor=#e6f4f1;strokeColor=#0f766e;strokeWidth=1.5;fontColor=#1f2933;align=left;fontSize=12;whiteSpace=wrap;spacing=8;" vertex="1" parent="p1-1"><mxGeometry x="1020" y="330" width="440" height="150" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="pag2" name="3 · Cómo conversa el chatbot">
    <mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="760" math="0" shadow="0">
      <root>
        <mxCell id="p2-0"/>
        <mxCell id="p2-1" parent="p2-0"/>
        <mxCell id="n9" value="3 · Cómo conversa el chatbot: seis reglas que aplican siempre" style="text;html=1;fontSize=26;fontStyle=1;fontColor=#1f2933;align=left;" vertex="1" parent="p2-1"><mxGeometry x="60" y="30" width="1380" height="34" as="geometry"/></mxCell>
        <mxCell id="n10" value="Antes de ver el registro paso a paso, conviene entender cómo funciona la conversación en general —
        estas reglas se repiten en todos los capítulos siguientes." style="text;html=1;whiteSpace=wrap;fontSize=13;fontColor=#5b6470;align=left;" vertex="1" parent="p2-1"><mxGeometry x="60" y="68" width="1380" height="40" as="geometry"/></mxCell>
        <mxCell id="g3_c0" value="&lt;b&gt;Puedes responder por voz&lt;/b&gt;&lt;br&gt;&lt;br&gt;Mantén pulsado el micrófono 🎤 y habla con naturalidad. El bot transcribe tu nota de voz a texto y sigue la conversación con normalidad." style="rounded=0;html=1;fillColor=#e6f4f1;strokeColor=#0f766e;strokeWidth=1.5;fontColor=#1f2933;align=left;fontSize=11;whiteSpace=wrap;spacing=8;" vertex="1" parent="p2-1"><mxGeometry x="60" y="150" width="440" height="170" as="geometry"/></mxCell>
        <mxCell id="g3_c1" value="&lt;b&gt;Las fotos siempre son opcionales&lt;/b&gt;&lt;br&gt;&lt;br&gt;En varios pasos el bot ofrece agregar una foto. Si no quieres o no puedes, escribe «omitir» y el registro continúa sin problema." style="rounded=0;html=1;fillColor=#e6f4f1;strokeColor=#0f766e;strokeWidth=1.5;fontColor=#1f2933;align=left;fontSize=11;whiteSpace=wrap;spacing=8;" vertex="1" parent="p2-1"><mxGeometry x="540" y="150" width="440" height="170" as="geometry"/></mxCell>
        <mxCell id="g3_c2" value="&lt;b&gt;Si no te entiende, te vuelve a preguntar&lt;/b&gt;&lt;br&gt;&lt;br&gt;Nunca se pierde tu avance: el bot te dice qué entendió y te repite las opciones numeradas para que elijas de nuevo." style="rounded=0;html=1;fillColor=#e6f4f1;strokeColor=#0f766e;strokeWidth=1.5;fontColor=#1f2933;align=left;fontSize=11;whiteSpace=wrap;spacing=8;" vertex="1" parent="p2-1"><mxGeometry x="1020" y="150" width="440" height="170" as="geometry"/></mxCell>
        <mxCell id="g3_c3" value="&lt;b&gt;Responde con el número, la palabra, o hablando&lt;/b&gt;&lt;br&gt;&lt;br&gt;En preguntas de opción múltiple puedes escribir el número (1️⃣, 2️⃣...), la palabra («croquis», «sí»), o decirlo en una nota de voz." style="rounded=0;html=1;fillColor=#e6f4f1;strokeColor=#0f766e;strokeWidth=1.5;fontColor=#1f2933;align=left;fontSize=11;whiteSpace=wrap;spacing=8;" vertex="1" parent="p2-1"><mxGeometry x="60" y="350" width="440" height="170" as="geometry"/></mxCell>
        <mxCell id="g3_c4" value="&lt;b&gt;No existe un comando para «cancelar»&lt;/b&gt;&lt;br&gt;&lt;br&gt;No hay una palabra que borre lo avanzado a mitad de camino. Para retomar más tarde, simplemente sigue respondiendo, o escribe «hola» de nuevo." style="rounded=0;html=1;fillColor=#e6f4f1;strokeColor=#0f766e;strokeWidth=1.5;fontColor=#1f2933;align=left;fontSize=11;whiteSpace=wrap;spacing=8;" vertex="1" parent="p2-1"><mxGeometry x="540" y="350" width="440" height="170" as="geometry"/></mxCell>
        <mxCell id="g3_c5" value="&lt;b&gt;No es un asistente de inteligencia artificial libre&lt;/b&gt;&lt;br&gt;&lt;br&gt;El bot sigue un guion fijo de preguntas — no conversa de temas sueltos ni responde preguntas fuera del registro territorial." style="rounded=0;html=1;fillColor=#e6f4f1;strokeColor=#0f766e;strokeWidth=1.5;fontColor=#1f2933;align=left;fontSize=11;whiteSpace=wrap;spacing=8;" vertex="1" parent="p2-1"><mxGeometry x="1020" y="350" width="440" height="170" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="pag3" name="4 · Registra tu territorio, paso a paso">
    <mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1072" math="0" shadow="0">
      <root>
        <mxCell id="p3-0"/>
        <mxCell id="p3-1" parent="p3-0"/>
        <mxCell id="n11" value="4 · Registra tu territorio colectivo, paso a paso" style="text;html=1;fontSize=26;fontStyle=1;fontColor=#1f2933;align=left;" vertex="1" parent="p3-1"><mxGeometry x="60" y="30" width="1380" height="34" as="geometry"/></mxCell>
        <mxCell id="n12" value="El recorrido completo, agrupado en 8 grandes momentos. El detalle de cada pregunta,
        módulo por módulo, está en el texto de este capítulo." style="text;html=1;whiteSpace=wrap;fontSize=13;fontColor=#5b6470;align=left;" vertex="1" parent="p3-1"><mxGeometry x="60" y="68" width="1380" height="40" as="geometry"/></mxCell>
        <mxCell id="g4_num0" value="1" style="rounded=1;arcSize=50;html=1;fillColor=#0f766e;strokeColor=#0f766e;fontColor=#ffffff;fontStyle=1;fontSize=12;whiteSpace=wrap;" vertex="1" parent="p3-1"><mxGeometry x="120" y="160" width="40" height="40" as="geometry"/></mxCell>
        <mxCell id="g4_num1" value="2" style="rounded=1;arcSize=50;html=1;fillColor=#0f766e;strokeColor=#0f766e;fontColor=#ffffff;fontStyle=1;fontSize=12;whiteSpace=wrap;" vertex="1" parent="p3-1"><mxGeometry x="120" y="262" width="40" height="40" as="geometry"/></mxCell>
        <mxCell id="g4_num2" value="3" style="rounded=1;arcSize=50;html=1;fillColor=#0f766e;strokeColor=#0f766e;fontColor=#ffffff;fontStyle=1;fontSize=12;whiteSpace=wrap;" vertex="1" parent="p3-1"><mxGeometry x="120" y="364" width="40" height="40" as="geometry"/></mxCell>
        <mxCell id="g4_num3" value="4" style="rounded=1;arcSize=50;html=1;fillColor=#0f766e;strokeColor=#0f766e;fontColor=#ffffff;fontStyle=1;fontSize=12;whiteSpace=wrap;" vertex="1" parent="p3-1"><mxGeometry x="120" y="466" width="40" height="40" as="geometry"/></mxCell>
        <mxCell id="g4_num4" value="5" style="rounded=1;arcSize=50;html=1;fillColor=#0f766e;strokeColor=#0f766e;fontColor=#ffffff;fontStyle=1;fontSize=12;whiteSpace=wrap;" vertex="1" parent="p3-1"><mxGeometry x="120" y="568" width="40" height="40" as="geometry"/></mxCell>
        <mxCell id="g4_num5" value="6" style="rounded=1;arcSize=50;html=1;fillColor=#0f766e;strokeColor=#0f766e;fontColor=#ffffff;fontStyle=1;fontSize=12;whiteSpace=wrap;" vertex="1" parent="p3-1"><mxGeometry x="120" y="670" width="40" height="40" as="geometry"/></mxCell>
        <mxCell id="g4_num6" value="7" style="rounded=1;arcSize=50;html=1;fillColor=#0f766e;strokeColor=#0f766e;fontColor=#ffffff;fontStyle=1;fontSize=12;whiteSpace=wrap;" vertex="1" parent="p3-1"><mxGeometry x="120" y="772" width="40" height="40" as="geometry"/></mxCell>
        <mxCell id="g4_num7" value="8" style="rounded=1;arcSize=50;html=1;fillColor=#0f766e;strokeColor=#0f766e;fontColor=#ffffff;fontStyle=1;fontSize=12;whiteSpace=wrap;" vertex="1" parent="p3-1"><mxGeometry x="120" y="874" width="40" height="40" as="geometry"/></mxCell>
        <mxCell id="g4_p0" value="&lt;b&gt;Consentimiento y preferencias&lt;/b&gt;&lt;br&gt;Confirmas que autorizas el registro, y eliges si prefieres responder con audio o solo texto." style="rounded=0;html=1;fillColor=#e6f4f1;strokeColor=#0f766e;strokeWidth=1.5;fontColor=#1f2933;align=left;fontSize=11;whiteSpace=wrap;spacing=8;" vertex="1" parent="p3-1"><mxGeometry x="220" y="160" width="1060" height="78" as="geometry"/></mxCell>
        <mxCell id="g4_p1" value="&lt;b&gt;Ubicación del territorio&lt;/b&gt;&lt;br&gt;Compartes el punto por GPS; si el bot no lo reconoce, completas municipio y vereda a mano." style="rounded=0;html=1;fillColor=#e6f4f1;strokeColor=#0f766e;strokeWidth=1.5;fontColor=#1f2933;align=left;fontSize=11;whiteSpace=wrap;spacing=8;" vertex="1" parent="p3-1"><mxGeometry x="220" y="262" width="1060" height="78" as="geometry"/></mxCell>
        <mxCell id="n13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;fontColor=#3a3f44;labelBackgroundColor=#ffffff;strokeColor=#0f766e;strokeWidth=1.6;endArrow=block;endFill=1;endSize=8;jumpStyle=arc;jumpSize=8;" edge="1" parent="p3-1" source="g4_p0" target="g4_p1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="g4_p2" value="&lt;b&gt;El perímetro (croquis o recorrido GPS)&lt;/b&gt;&lt;br&gt;Paso obligatorio — se hace en el navegador, con un enlace que el bot te envía (capítulo 5)." style="rounded=0;html=1;fillColor=#e6f4f1;strokeColor=#0f766e;strokeWidth=1.5;fontColor=#1f2933;align=left;fontSize=11;whiteSpace=wrap;spacing=8;" vertex="1" parent="p3-1"><mxGeometry x="220" y="364" width="1060" height="78" as="geometry"/></mxCell>
        <mxCell id="n14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;fontColor=#3a3f44;labelBackgroundColor=#ffffff;strokeColor=#0f766e;strokeWidth=1.6;endArrow=block;endFill=1;endSize=8;jumpStyle=arc;jumpSize=8;" edge="1" parent="p3-1" source="g4_p1" target="g4_p2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="g4_p3" value="&lt;b&gt;La comunidad y su representante&lt;/b&gt;&lt;br&gt;Nombre, pueblo, tipo de comunidad, número de familias — y luego quién la representa." style="rounded=0;html=1;fillColor=#e6f4f1;strokeColor=#0f766e;strokeWidth=1.5;fontColor=#1f2933;align=left;fontSize=11;whiteSpace=wrap;spacing=8;" vertex="1" parent="p3-1"><mxGeometry x="220" y="466" width="1060" height="78" as="geometry"/></mxCell>
        <mxCell id="n15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;fontColor=#3a3f44;labelBackgroundColor=#ffffff;strokeColor=#0f766e;strokeWidth=1.6;endArrow=block;endFill=1;endSize=8;jumpStyle=arc;jumpSize=8;" edge="1" parent="p3-1" source="g4_p2" target="g4_p3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="g4_p4" value="&lt;b&gt;Historia y datos formales del territorio&lt;/b&gt;&lt;br&gt;Cómo llegaron a este territorio, número predial, área aproximada, tipo de reconocimiento." style="rounded=0;html=1;fillColor=#e6f4f1;strokeColor=#0f766e;strokeWidth=1.5;fontColor=#1f2933;align=left;fontSize=11;whiteSpace=wrap;spacing=8;" vertex="1" parent="p3-1"><mxGeometry x="220" y="568" width="1060" height="78" as="geometry"/></mxCell>
        <mxCell id="n16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;fontColor=#3a3f44;labelBackgroundColor=#ffffff;strokeColor=#0f766e;strokeWidth=1.6;endArrow=block;endFill=1;endSize=8;jumpStyle=arc;jumpSize=8;" edge="1" parent="p3-1" source="g4_p3" target="g4_p4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="g4_p5" value="&lt;b&gt;Derechos, restricciones y uso de la tierra&lt;/b&gt;&lt;br&gt;Qué tipo de derecho tienen, si hay restricciones (minería, servidumbres) y para qué usan el territorio." style="rounded=0;html=1;fillColor=#e6f4f1;strokeColor=#0f766e;strokeWidth=1.5;fontColor=#1f2933;align=left;fontSize=11;whiteSpace=wrap;spacing=8;" vertex="1" parent="p3-1"><mxGeometry x="220" y="670" width="1060" height="78" as="geometry"/></mxCell>
        <mxCell id="n17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;fontColor=#3a3f44;labelBackgroundColor=#ffffff;strokeColor=#0f766e;strokeWidth=1.6;endArrow=block;endFill=1;endSize=8;jumpStyle=arc;jumpSize=8;" edge="1" parent="p3-1" source="g4_p4" target="g4_p5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="g4_p6" value="&lt;b&gt;Documentos legales y cartografía&lt;/b&gt;&lt;br&gt;El acto administrativo que respalda el territorio, y si existe un mapa o plano oficial." style="rounded=0;html=1;fillColor=#e6f4f1;strokeColor=#0f766e;strokeWidth=1.5;fontColor=#1f2933;align=left;fontSize=11;whiteSpace=wrap;spacing=8;" vertex="1" parent="p3-1"><mxGeometry x="220" y="772" width="1060" height="78" as="geometry"/></mxCell>
        <mxCell id="n18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;fontColor=#3a3f44;labelBackgroundColor=#ffffff;strokeColor=#0f766e;strokeWidth=1.6;endArrow=block;endFill=1;endSize=8;jumpStyle=arc;jumpSize=8;" edge="1" parent="p3-1" source="g4_p5" target="g4_p6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="g4_p7" value="&lt;b&gt;Validación final y cierre&lt;/b&gt;&lt;br&gt;La comunidad confirma que la información es correcta, y el bot guarda todo de forma segura." style="rounded=0;html=1;fillColor=#e6f4f1;strokeColor=#0f766e;strokeWidth=1.5;fontColor=#1f2933;align=left;fontSize=11;whiteSpace=wrap;spacing=8;" vertex="1" parent="p3-1"><mxGeometry x="220" y="874" width="1060" height="78" as="geometry"/></mxCell>
        <mxCell id="n19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;fontColor=#3a3f44;labelBackgroundColor=#ffffff;strokeColor=#0f766e;strokeWidth=1.6;endArrow=block;endFill=1;endSize=8;jumpStyle=arc;jumpSize=8;" edge="1" parent="p3-1" source="g4_p6" target="g4_p7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="g4_fin" value="Territorio colectivo guardado ✅" style="rounded=1;arcSize=50;html=1;fillColor=#199e70;strokeColor=#199e70;fontColor=#ffffff;fontStyle=1;fontSize=12;whiteSpace=wrap;" vertex="1" parent="p3-1"><mxGeometry x="220" y="976" width="1060" height="56" as="geometry"/></mxCell>
        <mxCell id="n20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;fontColor=#3a3f44;labelBackgroundColor=#ffffff;strokeColor=#0f766e;strokeWidth=1.6;endArrow=block;endFill=1;endSize=8;jumpStyle=arc;jumpSize=8;" edge="1" parent="p3-1" source="g4_p7" target="g4_fin"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="pag4" name="5 · El perímetro: croquis o recorrido GPS">
    <mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="930" math="0" shadow="0">
      <root>
        <mxCell id="p4-0"/>
        <mxCell id="p4-1" parent="p4-0"/>
        <mxCell id="n21" value="5 · El paso del perímetro: croquis o recorrido GPS" style="text;html=1;fontSize=26;fontStyle=1;fontColor=#1f2933;align=left;" vertex="1" parent="p4-1"><mxGeometry x="60" y="30" width="1380" height="34" as="geometry"/></mxCell>
        <mxCell id="n22" value="Este paso no se puede omitir — es indispensable para completar el registro. Se hace en el
        navegador del celular, no dentro de WhatsApp." style="text;html=1;whiteSpace=wrap;fontSize=13;fontColor=#5b6470;align=left;" vertex="1" parent="p4-1"><mxGeometry x="60" y="68" width="1380" height="40" as="geometry"/></mxCell>
        <mxCell id="g5_inicio" value="El bot pregunta cómo prefieres definir el perímetro" style="rounded=1;arcSize=50;html=1;fillColor=#0f766e;strokeColor=#0f766e;fontColor=#ffffff;fontStyle=1;fontSize=12;whiteSpace=wrap;" vertex="1" parent="p4-1"><mxGeometry x="490" y="160" width="520" height="56" as="geometry"/></mxCell>
        <mxCell id="g5_d" value="¿Cómo prefieres
        registrarlo?" style="rhombus;html=1;fillColor=#fdeee6;strokeColor=#d95926;strokeWidth=1.5;fontColor=#1f2933;fontSize=11;whiteSpace=wrap;" vertex="1" parent="p4-1"><mxGeometry x="590" y="250" width="320" height="90" as="geometry"/></mxCell>
        <mxCell id="g5_col1" value="" style="rounded=1;html=1;fillColor=none;strokeColor=#0f766e;strokeWidth=1.5;dashed=1;verticalAlign=top;fontColor=#0f766e;" vertex="1" parent="p4-1"><mxGeometry x="60" y="400" width="660" height="260" as="geometry"/></mxCell>
        <mxCell id="n23" value="✏️ Dibujar croquis" style="text;html=1;fontSize=13;fontStyle=1;fontColor=#0f766e;align=left;spacingLeft=10;" vertex="1" parent="p4-1"><mxGeometry x="68" y="378" width="644" height="20" as="geometry"/></mxCell>
        <mxCell id="g5_c1" value="1. Abres el enlace que envía el bot&lt;br&gt;&lt;br&gt;2. Tocas el mapa para marcar el contorno del territorio, punto por punto&lt;br&gt;&lt;br&gt;3. Guardas el croquis desde la misma página" style="rounded=0;html=1;fillColor=#e6f4f1;strokeColor=#0f766e;strokeWidth=1.5;fontColor=#1f2933;align=left;fontSize=11;whiteSpace=wrap;spacing=8;" vertex="1" parent="p4-1"><mxGeometry x="90" y="430" width="600" height="200" as="geometry"/></mxCell>
        <mxCell id="g5_col2" value="" style="rounded=1;html=1;fillColor=none;strokeColor=#2f6fb0;strokeWidth=1.5;dashed=1;verticalAlign=top;fontColor=#2f6fb0;" vertex="1" parent="p4-1"><mxGeometry x="780" y="400" width="660" height="260" as="geometry"/></mxCell>
        <mxCell id="n24" value="🚶 Recorrido GPS" style="text;html=1;fontSize=13;fontStyle=1;fontColor=#2f6fb0;align=left;spacingLeft=10;" vertex="1" parent="p4-1"><mxGeometry x="788" y="378" width="644" height="20" as="geometry"/></mxCell>
        <mxCell id="g5_c2" value="1. Abres el enlace que envía el bot&lt;br&gt;&lt;br&gt;2. Presionas «Iniciar recorrido» y caminas el borde del territorio con el GPS encendido&lt;br&gt;&lt;br&gt;3. Presionas «Detener» y guardas al terminar" style="rounded=0;html=1;fillColor=#eaf1fa;strokeColor=#2f6fb0;strokeWidth=1.5;fontColor=#1f2933;align=left;fontSize=11;whiteSpace=wrap;spacing=8;" vertex="1" parent="p4-1"><mxGeometry x="810" y="430" width="600" height="200" as="geometry"/></mxCell>
        <mxCell id="n25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;fontColor=#3a3f44;labelBackgroundColor=#ffffff;strokeColor=#0f766e;strokeWidth=1.6;endArrow=block;endFill=1;endSize=8;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;jumpStyle=arc;jumpSize=8;" edge="1" parent="p4-1" source="g5_d" target="g5_c1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="n26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;fontColor=#3a3f44;labelBackgroundColor=#ffffff;strokeColor=#2f6fb0;strokeWidth=1.6;endArrow=block;endFill=1;endSize=8;exitX=0.7;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;jumpStyle=arc;jumpSize=8;" edge="1" parent="p4-1" source="g5_d" target="g5_c2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="g5_fin" value="Regresas a WhatsApp y escribes «listo»" style="rounded=1;arcSize=50;html=1;fillColor=#199e70;strokeColor=#199e70;fontColor=#ffffff;fontStyle=1;fontSize=12;whiteSpace=wrap;" vertex="1" parent="p4-1"><mxGeometry x="470" y="700" width="560" height="60" as="geometry"/></mxCell>
        <mxCell id="n27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;fontColor=#3a3f44;labelBackgroundColor=#ffffff;strokeColor=#0f766e;strokeWidth=1.6;endArrow=block;endFill=1;endSize=8;jumpStyle=arc;jumpSize=8;" edge="1" parent="p4-1" source="g5_c1" target="g5_fin"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="n28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;fontColor=#3a3f44;labelBackgroundColor=#ffffff;strokeColor=#2f6fb0;strokeWidth=1.6;endArrow=block;endFill=1;endSize=8;jumpStyle=arc;jumpSize=8;" edge="1" parent="p4-1" source="g5_c2" target="g5_fin"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="g5_n1" value="El bot confirma el número de vértices y el área aproximada en hectáreas. Funciona incluso sin señal:
        la página guarda localmente y sincroniza sola cuando vuelve la conexión." style="shape=note;size=14;html=1;fillColor=#eef0f2;strokeColor=#5b6470;fontColor=#1f2933;fontSize=10;whiteSpace=wrap;align=left;spacing=6;" vertex="1" parent="p4-1"><mxGeometry x="350" y="800" width="800" height="90" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="pag5" name="6 · Registra la parcela de tu familia">
    <mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1060" math="0" shadow="0">
      <root>
        <mxCell id="p5-0"/>
        <mxCell id="p5-1" parent="p5-0"/>
        <mxCell id="n29" value="6 · Registra la parcela de tu familia" style="text;html=1;fontSize=26;fontStyle=1;fontColor=#1f2933;align=left;" vertex="1" parent="p5-1"><mxGeometry x="60" y="30" width="1380" height="34" as="geometry"/></mxCell>
        <mxCell id="n30" value="Si tu territorio colectivo ya está registrado y solo quieres agregar los datos de tu familia
        dentro de él, este camino es más corto." style="text;html=1;whiteSpace=wrap;fontSize=13;fontColor=#5b6470;align=left;" vertex="1" parent="p5-1"><mxGeometry x="60" y="68" width="1380" height="40" as="geometry"/></mxCell>
        <mxCell id="g6_num0" value="1" style="rounded=1;arcSize=50;html=1;fillColor=#0f766e;strokeColor=#0f766e;fontColor=#ffffff;fontStyle=1;fontSize=12;whiteSpace=wrap;" vertex="1" parent="p5-1"><mxGeometry x="120" y="170" width="40" height="40" as="geometry"/></mxCell>
        <mxCell id="g6_num1" value="2" style="rounded=1;arcSize=50;html=1;fillColor=#0f766e;strokeColor=#0f766e;fontColor=#ffffff;fontStyle=1;fontSize=12;whiteSpace=wrap;" vertex="1" parent="p5-1"><mxGeometry x="120" y="258" width="40" height="40" as="geometry"/></mxCell>
        <mxCell id="g6_num2" value="3" style="rounded=1;arcSize=50;html=1;fillColor=#0f766e;strokeColor=#0f766e;fontColor=#ffffff;fontStyle=1;fontSize=12;whiteSpace=wrap;" vertex="1" parent="p5-1"><mxGeometry x="120" y="346" width="40" height="40" as="geometry"/></mxCell>
        <mxCell id="g6_num3" value="4" style="rounded=1;arcSize=50;html=1;fillColor=#0f766e;strokeColor=#0f766e;fontColor=#ffffff;fontStyle=1;fontSize=12;whiteSpace=wrap;" vertex="1" parent="p5-1"><mxGeometry x="120" y="434" width="40" height="40" as="geometry"/></mxCell>
        <mxCell id="g6_num4" value="5" style="rounded=1;arcSize=50;html=1;fillColor=#0f766e;strokeColor=#0f766e;fontColor=#ffffff;fontStyle=1;fontSize=12;whiteSpace=wrap;" vertex="1" parent="p5-1"><mxGeometry x="120" y="522" width="40" height="40" as="geometry"/></mxCell>
        <mxCell id="g6_num5" value="6" style="rounded=1;arcSize=50;html=1;fillColor=#0f766e;strokeColor=#0f766e;fontColor=#ffffff;fontStyle=1;fontSize=12;whiteSpace=wrap;" vertex="1" parent="p5-1"><mxGeometry x="120" y="610" width="40" height="40" as="geometry"/></mxCell>
        <mxCell id="g6_num6" value="7" style="rounded=1;arcSize=50;html=1;fillColor=#0f766e;strokeColor=#0f766e;fontColor=#ffffff;fontStyle=1;fontSize=12;whiteSpace=wrap;" vertex="1" parent="p5-1"><mxGeometry x="120" y="698" width="40" height="40" as="geometry"/></mxCell>
        <mxCell id="g6_num7" value="8" style="rounded=1;arcSize=50;html=1;fillColor=#0f766e;strokeColor=#0f766e;fontColor=#ffffff;fontStyle=1;fontSize=12;whiteSpace=wrap;" vertex="1" parent="p5-1"><mxGeometry x="120" y="786" width="40" height="40" as="geometry"/></mxCell>
        <mxCell id="g6_p0" value="&lt;b&gt;Escribe «hola» o «registrar»&lt;/b&gt;" style="rounded=0;html=1;fillColor=#e6f4f1;strokeColor=#0f766e;strokeWidth=1.5;fontColor=#1f2933;align=left;fontSize=11;whiteSpace=wrap;spacing=8;" vertex="1" parent="p5-1"><mxGeometry x="220" y="170" width="1060" height="68" as="geometry"/></mxCell>
        <mxCell id="g6_p1" value="&lt;b&gt;Indica que quieres registrar la parcela de una familia&lt;/b&gt; — No el territorio completo." style="rounded=0;html=1;fillColor=#e6f4f1;strokeColor=#0f766e;strokeWidth=1.5;fontColor=#1f2933;align=left;fontSize=11;whiteSpace=wrap;spacing=8;" vertex="1" parent="p5-1"><mxGeometry x="220" y="258" width="1060" height="68" as="geometry"/></mxCell>
        <mxCell id="n31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;fontColor=#3a3f44;labelBackgroundColor=#ffffff;strokeColor=#0f766e;strokeWidth=1.6;endArrow=block;endFill=1;endSize=8;jumpStyle=arc;jumpSize=8;" edge="1" parent="p5-1" source="g6_p0" target="g6_p1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="g6_p2" value="&lt;b&gt;El bot busca a qué territorio pertenece&lt;/b&gt; — Con el nombre de tu comunidad, encuentra el registro colectivo ya existente." style="rounded=0;html=1;fillColor=#e6f4f1;strokeColor=#0f766e;strokeWidth=1.5;fontColor=#1f2933;align=left;fontSize=11;whiteSpace=wrap;spacing=8;" vertex="1" parent="p5-1"><mxGeometry x="220" y="346" width="1060" height="68" as="geometry"/></mxCell>
        <mxCell id="n32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;fontColor=#3a3f44;labelBackgroundColor=#ffffff;strokeColor=#0f766e;strokeWidth=1.6;endArrow=block;endFill=1;endSize=8;jumpStyle=arc;jumpSize=8;" edge="1" parent="p5-1" source="g6_p1" target="g6_p2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="g6_p3" value="&lt;b&gt;Comparte la ubicación de la parcela&lt;/b&gt; — El punto exacto donde vive o trabaja la familia." style="rounded=0;html=1;fillColor=#e6f4f1;strokeColor=#0f766e;strokeWidth=1.5;fontColor=#1f2933;align=left;fontSize=11;whiteSpace=wrap;spacing=8;" vertex="1" parent="p5-1"><mxGeometry x="220" y="434" width="1060" height="68" as="geometry"/></mxCell>
        <mxCell id="n33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;fontColor=#3a3f44;labelBackgroundColor=#ffffff;strokeColor=#0f766e;strokeWidth=1.6;endArrow=block;endFill=1;endSize=8;jumpStyle=arc;jumpSize=8;" edge="1" parent="p5-1" source="g6_p2" target="g6_p3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="g6_p4" value="&lt;b&gt;Define el perímetro de la parcela&lt;/b&gt; — Con el mismo mecanismo de croquis o recorrido GPS del capítulo 5." style="rounded=0;html=1;fillColor=#e6f4f1;strokeColor=#0f766e;strokeWidth=1.5;fontColor=#1f2933;align=left;fontSize=11;whiteSpace=wrap;spacing=8;" vertex="1" parent="p5-1"><mxGeometry x="220" y="522" width="1060" height="68" as="geometry"/></mxCell>
        <mxCell id="n34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;fontColor=#3a3f44;labelBackgroundColor=#ffffff;strokeColor=#0f766e;strokeWidth=1.6;endArrow=block;endFill=1;endSize=8;jumpStyle=arc;jumpSize=8;" edge="1" parent="p5-1" source="g6_p3" target="g6_p4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="g6_p5" value="&lt;b&gt;Datos del hogar&lt;/b&gt; — Jefe o jefa del hogar, documento, cuántas personas viven ahí y cuántas son mujeres." style="rounded=0;html=1;fillColor=#e6f4f1;strokeColor=#0f766e;strokeWidth=1.5;fontColor=#1f2933;align=left;fontSize=11;whiteSpace=wrap;spacing=8;" vertex="1" parent="p5-1"><mxGeometry x="220" y="610" width="1060" height="68" as="geometry"/></mxCell>
        <mxCell id="n35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;fontColor=#3a3f44;labelBackgroundColor=#ffffff;strokeColor=#0f766e;strokeWidth=1.6;endArrow=block;endFill=1;endSize=8;jumpStyle=arc;jumpSize=8;" edge="1" parent="p5-1" source="g6_p4" target="g6_p5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="g6_p6" value="&lt;b&gt;Antigüedad y origen de la ocupación&lt;/b&gt; — Desde cuándo, y cómo llegó la familia a ocupar ese lugar." style="rounded=0;html=1;fillColor=#e6f4f1;strokeColor=#0f766e;strokeWidth=1.5;fontColor=#1f2933;align=left;fontSize=11;whiteSpace=wrap;spacing=8;" vertex="1" parent="p5-1"><mxGeometry x="220" y="698" width="1060" height="68" as="geometry"/></mxCell>
        <mxCell id="n36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;fontColor=#3a3f44;labelBackgroundColor=#ffffff;strokeColor=#0f766e;strokeWidth=1.6;endArrow=block;endFill=1;endSize=8;jumpStyle=arc;jumpSize=8;" edge="1" parent="p5-1" source="g6_p5" target="g6_p6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="g6_p7" value="&lt;b&gt;Uso del lugar y foto opcional&lt;/b&gt; — Vivienda, cultivo, cría de animales — y una foto si quieres agregarla." style="rounded=0;html=1;fillColor=#e6f4f1;strokeColor=#0f766e;strokeWidth=1.5;fontColor=#1f2933;align=left;fontSize=11;whiteSpace=wrap;spacing=8;" vertex="1" parent="p5-1"><mxGeometry x="220" y="786" width="1060" height="68" as="geometry"/></mxCell>
        <mxCell id="n37" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;fontColor=#3a3f44;labelBackgroundColor=#ffffff;strokeColor=#0f766e;strokeWidth=1.6;endArrow=block;endFill=1;endSize=8;jumpStyle=arc;jumpSize=8;" edge="1" parent="p5-1" source="g6_p6" target="g6_p7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="g6_fin" value="Parcela familiar guardada ✅" style="rounded=1;arcSize=50;html=1;fillColor=#199e70;strokeColor=#199e70;fontColor=#ffffff;fontStyle=1;fontSize=12;whiteSpace=wrap;" vertex="1" parent="p5-1"><mxGeometry x="220" y="874" width="1060" height="56" as="geometry"/></mxCell>
        <mxCell id="n38" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;fontColor=#3a3f44;labelBackgroundColor=#ffffff;strokeColor=#0f766e;strokeWidth=1.6;endArrow=block;endFill=1;endSize=8;jumpStyle=arc;jumpSize=8;" edge="1" parent="p5-1" source="g6_p7" target="g6_fin"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="g6_n1" value="Al terminar, el bot te pregunta si quieres registrar otra familia dentro del mismo territorio —
        puedes encadenar varios registros seguidos, uno tras otro." style="shape=note;size=14;html=1;fillColor=#fdeee6;strokeColor=#d95926;fontColor=#1f2933;fontSize=10;whiteSpace=wrap;align=left;spacing=6;" vertex="1" parent="p5-1"><mxGeometry x="220" y="950" width="1060" height="70" as="geometry"/></mxCell>
        <mxCell id="n39" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;fontColor=#3a3f44;labelBackgroundColor=#ffffff;strokeColor=#d95926;strokeWidth=1.6;endArrow=block;endFill=1;endSize=8;dashed=1;jumpStyle=arc;jumpSize=8;" edge="1" parent="p5-1" source="g6_fin" target="g6_n1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="pag6" name="7 · Sin internet, errores y límites del bot">
    <mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="620" math="0" shadow="0">
      <root>
        <mxCell id="p6-0"/>
        <mxCell id="p6-1" parent="p6-0"/>
        <mxCell id="n40" value="7 · Si no tienes internet, si te equivocas, y qué NO hace el chatbot" style="text;html=1;fontSize=26;fontStyle=1;fontColor=#1f2933;align=left;" vertex="1" parent="p6-1"><mxGeometry x="60" y="30" width="1580" height="34" as="geometry"/></mxCell>
        <mxCell id="n41" value="Tres situaciones distintas, para que sepas qué esperar en cada una." style="text;html=1;whiteSpace=wrap;fontSize=13;fontColor=#5b6470;align=left;" vertex="1" parent="p6-1"><mxGeometry x="60" y="68" width="1580" height="40" as="geometry"/></mxCell>
        <mxCell id="g7_col1" value="" style="rounded=1;html=1;fillColor=none;strokeColor=#0f766e;strokeWidth=1.5;dashed=1;verticalAlign=top;fontColor=#0f766e;" vertex="1" parent="p6-1"><mxGeometry x="60" y="160" width="500" height="420" as="geometry"/></mxCell>
        <mxCell id="n42" value="¿Se corta tu internet?" style="text;html=1;fontSize=13;fontStyle=1;fontColor=#0f766e;align=left;spacingLeft=10;" vertex="1" parent="p6-1"><mxGeometry x="68" y="138" width="484" height="20" as="geometry"/></mxCell>
        <mxCell id="g7_r1" value="Cada respuesta se guarda de inmediato, aunque la conexión falle. Tú sigues viendo la conversación con normalidad, sin reiniciar nada." style="rounded=0;html=1;fillColor=#e6f4f1;strokeColor=#0f766e;strokeWidth=1.5;fontColor=#1f2933;align=left;fontSize=11;whiteSpace=wrap;spacing=8;" vertex="1" parent="p6-1"><mxGeometry x="90" y="200" width="440" height="160" as="geometry"/></mxCell>
        <mxCell id="g7_r2" value="Apenas vuelva la señal, el sistema sincroniza solo. Si el bot no logra conectarse con el servidor, tu registro queda guardado con un ID temporal, sin perderse." style="rounded=0;html=1;fillColor=#e8f6ef;strokeColor=#199e70;strokeWidth=1.5;fontColor=#1f2933;align=left;fontSize=11;whiteSpace=wrap;spacing=8;" vertex="1" parent="p6-1"><mxGeometry x="90" y="380" width="440" height="100" as="geometry"/></mxCell>
        <mxCell id="n43" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;fontColor=#3a3f44;labelBackgroundColor=#ffffff;strokeColor=#0f766e;strokeWidth=1.6;endArrow=block;endFill=1;endSize=8;jumpStyle=arc;jumpSize=8;" edge="1" parent="p6-1" source="g7_r1" target="g7_r2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="g7_col2" value="" style="rounded=1;html=1;fillColor=none;strokeColor=#2f6fb0;strokeWidth=1.5;dashed=1;verticalAlign=top;fontColor=#2f6fb0;" vertex="1" parent="p6-1"><mxGeometry x="600" y="160" width="500" height="420" as="geometry"/></mxCell>
        <mxCell id="n44" value="¿Te equivocas al responder?" style="text;html=1;fontSize=13;fontStyle=1;fontColor=#2f6fb0;align=left;spacingLeft=10;" vertex="1" parent="p6-1"><mxGeometry x="608" y="138" width="484" height="20" as="geometry"/></mxCell>
        <mxCell id="g7_r3" value="Si el bot no entiende una respuesta, te dice qué escuchó y te repite las opciones numeradas — no pierdes lo que ya habías avanzado en la conversación." style="rounded=0;html=1;fillColor=#eaf1fa;strokeColor=#2f6fb0;strokeWidth=1.5;fontColor=#1f2933;align=left;fontSize=11;whiteSpace=wrap;spacing=8;" vertex="1" parent="p6-1"><mxGeometry x="630" y="200" width="440" height="160" as="geometry"/></mxCell>
        <mxCell id="g7_r4" value="Para corregir un dato ya guardado en un registro anterior, avísale a Katherine — ella puede revisarlo desde el visor." style="rounded=0;html=1;fillColor=#eaf1fa;strokeColor=#2f6fb0;strokeWidth=1.5;fontColor=#1f2933;align=left;fontSize=11;whiteSpace=wrap;spacing=8;" vertex="1" parent="p6-1"><mxGeometry x="630" y="380" width="440" height="100" as="geometry"/></mxCell>
        <mxCell id="n45" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;fontColor=#3a3f44;labelBackgroundColor=#ffffff;strokeColor=#2f6fb0;strokeWidth=1.6;endArrow=block;endFill=1;endSize=8;jumpStyle=arc;jumpSize=8;" edge="1" parent="p6-1" source="g7_r3" target="g7_r4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="g7_col3" value="" style="rounded=1;html=1;fillColor=none;strokeColor=#d95926;strokeWidth=1.5;dashed=1;verticalAlign=top;fontColor=#d95926;" vertex="1" parent="p6-1"><mxGeometry x="1140" y="160" width="500" height="420" as="geometry"/></mxCell>
        <mxCell id="n46" value="Cosas que el bot NO hace" style="text;html=1;fontSize=13;fontStyle=1;fontColor=#d95926;align=left;spacingLeft=10;" vertex="1" parent="p6-1"><mxGeometry x="1148" y="138" width="484" height="20" as="geometry"/></mxCell>
        <mxCell id="g7_r5" value="• No tiene un comando para «cancelar» un registro a medias&lt;br&gt;&lt;br&gt;• No tiene un menú de ayuda con opciones para elegir&lt;br&gt;&lt;br&gt;• No distingue roles: cualquiera que escriba puede registrar&lt;br&gt;&lt;br&gt;• No genera un PDF ni un certificado descargable&lt;br&gt;&lt;br&gt;• No conversa libremente como un asistente de IA" style="rounded=0;html=1;fillColor=#fdeee6;strokeColor=#d95926;strokeWidth=1.5;fontColor=#1f2933;align=left;fontSize=11;whiteSpace=wrap;spacing=8;" vertex="1" parent="p6-1"><mxGeometry x="1170" y="200" width="440" height="280" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="pag7" name="8 · Cómo entrar al visor">
    <mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="752" math="0" shadow="0">
      <root>
        <mxCell id="p7-0"/>
        <mxCell id="p7-1" parent="p7-0"/>
        <mxCell id="n47" value="8 · Cómo entrar al visor" style="text;html=1;fontSize=26;fontStyle=1;fontColor=#1f2933;align=left;" vertex="1" parent="p7-1"><mxGeometry x="60" y="30" width="1380" height="34" as="geometry"/></mxCell>
        <mxCell id="n48" value="A partir de aquí, el manual es para Katherine: cómo entrar al visor geográfico y qué
        puede hacer una vez adentro, según su rol." style="text;html=1;whiteSpace=wrap;fontSize=13;fontColor=#5b6470;align=left;" vertex="1" parent="p7-1"><mxGeometry x="60" y="68" width="1380" height="40" as="geometry"/></mxCell>
        <mxCell id="g8_num0" value="1" style="rounded=1;arcSize=50;html=1;fillColor=#2f6fb0;strokeColor=#2f6fb0;fontColor=#ffffff;fontStyle=1;fontSize=12;whiteSpace=wrap;" vertex="1" parent="p7-1"><mxGeometry x="120" y="170" width="40" height="40" as="geometry"/></mxCell>
        <mxCell id="g8_num1" value="2" style="rounded=1;arcSize=50;html=1;fillColor=#2f6fb0;strokeColor=#2f6fb0;fontColor=#ffffff;fontStyle=1;fontSize=12;whiteSpace=wrap;" vertex="1" parent="p7-1"><mxGeometry x="120" y="264" width="40" height="40" as="geometry"/></mxCell>
        <mxCell id="g8_num2" value="3" style="rounded=1;arcSize=50;html=1;fillColor=#2f6fb0;strokeColor=#2f6fb0;fontColor=#ffffff;fontStyle=1;fontSize=12;whiteSpace=wrap;" vertex="1" parent="p7-1"><mxGeometry x="120" y="358" width="40" height="40" as="geometry"/></mxCell>
        <mxCell id="g8_num3" value="4" style="rounded=1;arcSize=50;html=1;fillColor=#2f6fb0;strokeColor=#2f6fb0;fontColor=#ffffff;fontStyle=1;fontSize=12;whiteSpace=wrap;" vertex="1" parent="p7-1"><mxGeometry x="120" y="452" width="40" height="40" as="geometry"/></mxCell>
        <mxCell id="g8_p0" value="&lt;b&gt;Abre el navegador&lt;/b&gt; — Chrome, Firefox o el que uses normalmente." style="rounded=0;html=1;fillColor=#eaf1fa;strokeColor=#2f6fb0;strokeWidth=1.5;fontColor=#1f2933;align=left;fontSize=12;whiteSpace=wrap;spacing=8;" vertex="1" parent="p7-1"><mxGeometry x="220" y="170" width="1060" height="70" as="geometry"/></mxCell>
        <mxCell id="g8_p1" value="&lt;b&gt;Entra a la dirección del visor&lt;/b&gt; — En tu propio computador, o la URL pública si lo revisas desde otro lugar." style="rounded=0;html=1;fillColor=#eaf1fa;strokeColor=#2f6fb0;strokeWidth=1.5;fontColor=#1f2933;align=left;fontSize=12;whiteSpace=wrap;spacing=8;" vertex="1" parent="p7-1"><mxGeometry x="220" y="264" width="1060" height="70" as="geometry"/></mxCell>
        <mxCell id="n49" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;fontColor=#3a3f44;labelBackgroundColor=#ffffff;strokeColor=#2f6fb0;strokeWidth=1.6;endArrow=block;endFill=1;endSize=8;jumpStyle=arc;jumpSize=8;" edge="1" parent="p7-1" source="g8_p0" target="g8_p1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="g8_p2" value="&lt;b&gt;Escribe tu usuario y tu contraseña&lt;/b&gt; — Los mismos que usas siempre para entrar al visor." style="rounded=0;html=1;fillColor=#eaf1fa;strokeColor=#2f6fb0;strokeWidth=1.5;fontColor=#1f2933;align=left;fontSize=12;whiteSpace=wrap;spacing=8;" vertex="1" parent="p7-1"><mxGeometry x="220" y="358" width="1060" height="70" as="geometry"/></mxCell>
        <mxCell id="n50" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;fontColor=#3a3f44;labelBackgroundColor=#ffffff;strokeColor=#2f6fb0;strokeWidth=1.6;endArrow=block;endFill=1;endSize=8;jumpStyle=arc;jumpSize=8;" edge="1" parent="p7-1" source="g8_p1" target="g8_p2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="g8_p3" value="&lt;b&gt;Dale clic en «Iniciar sesión»&lt;/b&gt;" style="rounded=0;html=1;fillColor=#eaf1fa;strokeColor=#2f6fb0;strokeWidth=1.5;fontColor=#1f2933;align=left;fontSize=12;whiteSpace=wrap;spacing=8;" vertex="1" parent="p7-1"><mxGeometry x="220" y="452" width="1060" height="70" as="geometry"/></mxCell>
        <mxCell id="n51" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;fontColor=#3a3f44;labelBackgroundColor=#ffffff;strokeColor=#2f6fb0;strokeWidth=1.6;endArrow=block;endFill=1;endSize=8;jumpStyle=arc;jumpSize=8;" edge="1" parent="p7-1" source="g8_p2" target="g8_p3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="g8_fin" value="Adentro del visor, por las próximas 8 horas" style="rounded=1;arcSize=50;html=1;fillColor=#199e70;strokeColor=#199e70;fontColor=#ffffff;fontStyle=1;fontSize=12;whiteSpace=wrap;" vertex="1" parent="p7-1"><mxGeometry x="220" y="546" width="1060" height="56" as="geometry"/></mxCell>
        <mxCell id="n52" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;fontColor=#3a3f44;labelBackgroundColor=#ffffff;strokeColor=#2f6fb0;strokeWidth=1.6;endArrow=block;endFill=1;endSize=8;jumpStyle=arc;jumpSize=8;" edge="1" parent="p7-1" source="g8_p3" target="g8_fin"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="g8_n1" value="Pasadas las 8 horas, el visor te vuelve a pedir la contraseña — es normal, es la forma en que protege
        la información. Además, existen dos roles: administradora (acceso completo) y lectora (solo consulta,
        sin enviar mensajes al chatbot ni gestionar usuarios)." style="shape=note;size=14;html=1;fillColor=#fdeee6;strokeColor=#d95926;fontColor=#1f2933;fontSize=10;whiteSpace=wrap;align=left;spacing=6;" vertex="1" parent="p7-1"><mxGeometry x="220" y="622" width="1060" height="90" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="pag8" name="9 · El mapa, búsqueda y vistas">
    <mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="810" math="0" shadow="0">
      <root>
        <mxCell id="p8-0"/>
        <mxCell id="p8-1" parent="p8-0"/>
        <mxCell id="n53" value="9 · El mapa: búsqueda, filtros y las tres formas de verlo" style="text;html=1;fontSize=26;fontStyle=1;fontColor=#1f2933;align=left;" vertex="1" parent="p8-1"><mxGeometry x="60" y="30" width="1580" height="34" as="geometry"/></mxCell>
        <mxCell id="n54" value="Así está organizada la pantalla principal del visor. Los números de aquí corresponden a
        la lista de la derecha." style="text;html=1;whiteSpace=wrap;fontSize=13;fontColor=#5b6470;align=left;" vertex="1" parent="p8-1"><mxGeometry x="60" y="68" width="1580" height="40" as="geometry"/></mxCell>
        <mxCell id="g9_win" value="" style="rounded=0;html=1;fillColor=#eef0f2;strokeColor=#5b6470;strokeWidth=1.5;fontColor=#1f2933;align=center;fontSize=12;whiteSpace=wrap;spacing=8;" vertex="1" parent="p8-1"><mxGeometry x="60" y="150" width="980" height="620" as="geometry"/></mxCell>
        <mxCell id="g9_top" value="Geovisor Catastro Étnico     |     Mapa · Dashboard · Timeline     |     alertas · sesión" style="rounded=0;html=1;fillColor=#eaf1fa;strokeColor=#2f6fb0;strokeWidth=1.5;fontColor=#1f2933;align=center;fontSize=11;whiteSpace=wrap;spacing=8;" vertex="1" parent="p8-1"><mxGeometry x="70" y="160" width="960" height="50" as="geometry"/></mxCell>
        <mxCell id="g9_n6" value="6" style="rounded=1;arcSize=50;html=1;fillColor=#2f6fb0;strokeColor=#2f6fb0;fontColor=#ffffff;fontStyle=1;fontSize=12;whiteSpace=wrap;" vertex="1" parent="p8-1"><mxGeometry x="1000" y="160" width="34" height="34" as="geometry"/></mxCell>
        <mxCell id="g9_pan1" value="Búsqueda" style="rounded=0;html=1;fillColor=#eaf1fa;strokeColor=#2f6fb0;strokeWidth=1.5;fontColor=#1f2933;align=center;fontSize=11;whiteSpace=wrap;spacing=8;" vertex="1" parent="p8-1"><mxGeometry x="70" y="220" width="260" height="50" as="geometry"/></mxCell>
        <mxCell id="g9_n1" value="1" style="rounded=1;arcSize=50;html=1;fillColor=#2f6fb0;strokeColor=#2f6fb0;fontColor=#ffffff;fontStyle=1;fontSize=12;whiteSpace=wrap;" vertex="1" parent="p8-1"><mxGeometry x="300" y="210" width="30" height="30" as="geometry"/></mxCell>
        <mxCell id="g9_pan2" value="Filtros: tipo, departamento,
        derecho, fechas — botón Aplicar" style="rounded=0;html=1;fillColor=#eaf1fa;strokeColor=#2f6fb0;strokeWidth=1.5;fontColor=#1f2933;align=center;fontSize=11;whiteSpace=wrap;spacing=8;" vertex="1" parent="p8-1"><mxGeometry x="70" y="280" width="260" height="80" as="geometry"/></mxCell>
        <mxCell id="g9_n2" value="2" style="rounded=1;arcSize=50;html=1;fillColor=#2f6fb0;strokeColor=#2f6fb0;fontColor=#ffffff;fontStyle=1;fontSize=12;whiteSpace=wrap;" vertex="1" parent="p8-1"><mxGeometry x="300" y="270" width="30" height="30" as="geometry"/></mxCell>
        <mxCell id="g9_pan3" value="Vista del mapa:
        Puntos · Cluster · Calor" style="rounded=0;html=1;fillColor=#eaf1fa;strokeColor=#2f6fb0;strokeWidth=1.5;fontColor=#1f2933;align=center;fontSize=11;whiteSpace=wrap;spacing=8;" vertex="1" parent="p8-1"><mxGeometry x="70" y="370" width="260" height="60" as="geometry"/></mxCell>
        <mxCell id="g9_n3" value="3" style="rounded=1;arcSize=50;html=1;fillColor=#2f6fb0;strokeColor=#2f6fb0;fontColor=#ffffff;fontStyle=1;fontSize=12;whiteSpace=wrap;" vertex="1" parent="p8-1"><mxGeometry x="300" y="360" width="30" height="30" as="geometry"/></mxCell>
        <mxCell id="g9_pan4" value="Parcelas familiares
        (casilla para mostrarlas)" style="rounded=0;html=1;fillColor=#eaf1fa;strokeColor=#2f6fb0;strokeWidth=1.5;fontColor=#1f2933;align=center;fontSize=11;whiteSpace=wrap;spacing=8;" vertex="1" parent="p8-1"><mxGeometry x="70" y="440" width="260" height="60" as="geometry"/></mxCell>
        <mxCell id="g9_n4" value="4" style="rounded=1;arcSize=50;html=1;fillColor=#2f6fb0;strokeColor=#2f6fb0;fontColor=#ffffff;fontStyle=1;fontSize=12;whiteSpace=wrap;" vertex="1" parent="p8-1"><mxGeometry x="300" y="430" width="30" height="30" as="geometry"/></mxCell>
        <mxCell id="g9_pan5" value="Lista de registros
        encontrados" style="rounded=0;html=1;fillColor=#eaf1fa;strokeColor=#2f6fb0;strokeWidth=1.5;fontColor=#1f2933;align=center;fontSize=11;whiteSpace=wrap;spacing=8;" vertex="1" parent="p8-1"><mxGeometry x="70" y="510" width="260" height="240" as="geometry"/></mxCell>
        <mxCell id="g9_n5b" value="5" style="rounded=1;arcSize=50;html=1;fillColor=#2f6fb0;strokeColor=#2f6fb0;fontColor=#ffffff;fontStyle=1;fontSize=12;whiteSpace=wrap;" vertex="1" parent="p8-1"><mxGeometry x="300" y="500" width="30" height="30" as="geometry"/></mxCell>
        <mxCell id="g9_mapa" value="El mapa" style="rounded=0;html=1;fillColor=#e8f6ef;strokeColor=#199e70;strokeWidth=1.5;fontColor=#1f2933;align=center;fontSize=13;fontStyle=1;whiteSpace=wrap;spacing=8;" vertex="1" parent="p8-1"><mxGeometry x="340" y="220" width="690" height="530" as="geometry"/></mxCell>
        <mxCell id="g9_leg0" value="1" style="rounded=1;arcSize=50;html=1;fillColor=#2f6fb0;strokeColor=#2f6fb0;fontColor=#ffffff;fontStyle=1;fontSize=12;whiteSpace=wrap;" vertex="1" parent="p8-1"><mxGeometry x="1100" y="150" width="30" height="30" as="geometry"/></mxCell>
        <mxCell id="n55" value="&lt;b&gt;Búsqueda&lt;/b&gt;&lt;br&gt;Escribe el nombre de la comunidad, pueblo o municipio." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1f2933;" vertex="1" parent="p8-1"><mxGeometry x="1142" y="146" width="498" height="90" as="geometry"/></mxCell>
        <mxCell id="g9_leg1" value="2" style="rounded=1;arcSize=50;html=1;fillColor=#2f6fb0;strokeColor=#2f6fb0;fontColor=#ffffff;fontStyle=1;fontSize=12;whiteSpace=wrap;" vertex="1" parent="p8-1"><mxGeometry x="1100" y="250" width="30" height="30" as="geometry"/></mxCell>
        <mxCell id="n56" value="&lt;b&gt;Filtros&lt;/b&gt;&lt;br&gt;Por tipo de registro, departamento, tipo de derecho o rango de fechas." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1f2933;" vertex="1" parent="p8-1"><mxGeometry x="1142" y="246" width="498" height="90" as="geometry"/></mxCell>
        <mxCell id="g9_leg2" value="3" style="rounded=1;arcSize=50;html=1;fillColor=#2f6fb0;strokeColor=#2f6fb0;fontColor=#ffffff;fontStyle=1;fontSize=12;whiteSpace=wrap;" vertex="1" parent="p8-1"><mxGeometry x="1100" y="350" width="30" height="30" as="geometry"/></mxCell>
        <mxCell id="n57" value="&lt;b&gt;Vista del mapa&lt;/b&gt;&lt;br&gt;Puntos individuales, agrupados en cluster, o mapa de calor por densidad." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1f2933;" vertex="1" parent="p8-1"><mxGeometry x="1142" y="346" width="498" height="90" as="geometry"/></mxCell>
        <mxCell id="g9_leg3" value="4" style="rounded=1;arcSize=50;html=1;fillColor=#2f6fb0;strokeColor=#2f6fb0;fontColor=#ffffff;fontStyle=1;fontSize=12;whiteSpace=wrap;" vertex="1" parent="p8-1"><mxGeometry x="1100" y="450" width="30" height="30" as="geometry"/></mxCell>
        <mxCell id="n58" value="&lt;b&gt;Parcelas familiares&lt;/b&gt;&lt;br&gt;Muestra u oculta los polígonos naranja de las familias, dentro de cada territorio." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1f2933;" vertex="1" parent="p8-1"><mxGeometry x="1142" y="446" width="498" height="90" as="geometry"/></mxCell>
        <mxCell id="g9_leg4" value="5" style="rounded=1;arcSize=50;html=1;fillColor=#2f6fb0;strokeColor=#2f6fb0;fontColor=#ffffff;fontStyle=1;fontSize=12;whiteSpace=wrap;" vertex="1" parent="p8-1"><mxGeometry x="1100" y="550" width="30" height="30" as="geometry"/></mxCell>
        <mxCell id="n59" value="&lt;b&gt;Lista de registros&lt;/b&gt;&lt;br&gt;Los resultados de tu búsqueda — dales clic para abrir su ficha." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1f2933;" vertex="1" parent="p8-1"><mxGeometry x="1142" y="546" width="498" height="90" as="geometry"/></mxCell>
        <mxCell id="g9_leg5" value="6" style="rounded=1;arcSize=50;html=1;fillColor=#2f6fb0;strokeColor=#2f6fb0;fontColor=#ffffff;fontStyle=1;fontSize=12;whiteSpace=wrap;" vertex="1" parent="p8-1"><mxGeometry x="1100" y="650" width="30" height="30" as="geometry"/></mxCell>
        <mxCell id="n60" value="&lt;b&gt;Barra superior&lt;/b&gt;&lt;br&gt;Cambia entre Mapa, Dashboard y Timeline, y revisa alertas y tu sesión." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1f2933;" vertex="1" parent="p8-1"><mxGeometry x="1142" y="646" width="498" height="90" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="pag9" name="10 · Parcelas familiares en el mapa">
    <mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="688" math="0" shadow="0">
      <root>
        <mxCell id="p9-0"/>
        <mxCell id="p9-1" parent="p9-0"/>
        <mxCell id="n61" value="10 · Ver las parcelas familiares en el mapa" style="text;html=1;fontSize=26;fontStyle=1;fontColor=#1f2933;align=left;" vertex="1" parent="p9-1"><mxGeometry x="60" y="30" width="1380" height="34" as="geometry"/></mxCell>
        <mxCell id="n62" value="Los territorios colectivos son un tipo de registro; las parcelas de cada familia dentro de
        ellos son otro. El mapa los distingue con un estilo propio." style="text;html=1;whiteSpace=wrap;fontSize=13;fontColor=#5b6470;align=left;" vertex="1" parent="p9-1"><mxGeometry x="60" y="68" width="1380" height="40" as="geometry"/></mxCell>
        <mxCell id="g10_num0" value="1" style="rounded=1;arcSize=50;html=1;fillColor=#2f6fb0;strokeColor=#2f6fb0;fontColor=#ffffff;fontStyle=1;fontSize=12;whiteSpace=wrap;" vertex="1" parent="p9-1"><mxGeometry x="120" y="170" width="40" height="40" as="geometry"/></mxCell>
        <mxCell id="g10_num1" value="2" style="rounded=1;arcSize=50;html=1;fillColor=#2f6fb0;strokeColor=#2f6fb0;fontColor=#ffffff;fontStyle=1;fontSize=12;whiteSpace=wrap;" vertex="1" parent="p9-1"><mxGeometry x="120" y="272" width="40" height="40" as="geometry"/></mxCell>
        <mxCell id="g10_num2" value="3" style="rounded=1;arcSize=50;html=1;fillColor=#2f6fb0;strokeColor=#2f6fb0;fontColor=#ffffff;fontStyle=1;fontSize=12;whiteSpace=wrap;" vertex="1" parent="p9-1"><mxGeometry x="120" y="374" width="40" height="40" as="geometry"/></mxCell>
        <mxCell id="g10_num3" value="4" style="rounded=1;arcSize=50;html=1;fillColor=#2f6fb0;strokeColor=#2f6fb0;fontColor=#ffffff;fontStyle=1;fontSize=12;whiteSpace=wrap;" vertex="1" parent="p9-1"><mxGeometry x="120" y="476" width="40" height="40" as="geometry"/></mxCell>
        <mxCell id="g10_p0" value="&lt;b&gt;Marca la casilla «Mostrar en el mapa»&lt;/b&gt;&lt;br&gt;En la sección «Parcelas familiares» del panel izquierdo." style="rounded=0;html=1;fillColor=#eaf1fa;strokeColor=#2f6fb0;strokeWidth=1.5;fontColor=#1f2933;align=left;fontSize=11;whiteSpace=wrap;spacing=8;" vertex="1" parent="p9-1"><mxGeometry x="220" y="170" width="1060" height="78" as="geometry"/></mxCell>
        <mxCell id="g10_p1" value="&lt;b&gt;El visor consulta las parcelas registradas&lt;/b&gt;&lt;br&gt;Aparece «Cargando…» mientras trae la información del servidor." style="rounded=0;html=1;fillColor=#eaf1fa;strokeColor=#2f6fb0;strokeWidth=1.5;fontColor=#1f2933;align=left;fontSize=11;whiteSpace=wrap;spacing=8;" vertex="1" parent="p9-1"><mxGeometry x="220" y="272" width="1060" height="78" as="geometry"/></mxCell>
        <mxCell id="n63" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;fontColor=#3a3f44;labelBackgroundColor=#ffffff;strokeColor=#2f6fb0;strokeWidth=1.6;endArrow=block;endFill=1;endSize=8;jumpStyle=arc;jumpSize=8;" edge="1" parent="p9-1" source="g10_p0" target="g10_p1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="g10_p2" value="&lt;b&gt;Las parcelas se dibujan en naranja punteado&lt;/b&gt;&lt;br&gt;Para distinguirlas de los territorios colectivos, que se ven en su color por tipo de comunidad." style="rounded=0;html=1;fillColor=#eaf1fa;strokeColor=#2f6fb0;strokeWidth=1.5;fontColor=#1f2933;align=left;fontSize=11;whiteSpace=wrap;spacing=8;" vertex="1" parent="p9-1"><mxGeometry x="220" y="374" width="1060" height="78" as="geometry"/></mxCell>
        <mxCell id="n64" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;fontColor=#3a3f44;labelBackgroundColor=#ffffff;strokeColor=#2f6fb0;strokeWidth=1.6;endArrow=block;endFill=1;endSize=8;jumpStyle=arc;jumpSize=8;" edge="1" parent="p9-1" source="g10_p1" target="g10_p2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="g10_p3" value="&lt;b&gt;Dale clic a una parcela&lt;/b&gt;&lt;br&gt;Se abre un popup con la familia, cuántas personas viven ahí y el área medida." style="rounded=0;html=1;fillColor=#eaf1fa;strokeColor=#2f6fb0;strokeWidth=1.5;fontColor=#1f2933;align=left;fontSize=11;whiteSpace=wrap;spacing=8;" vertex="1" parent="p9-1"><mxGeometry x="220" y="476" width="1060" height="78" as="geometry"/></mxCell>
        <mxCell id="n65" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;fontColor=#3a3f44;labelBackgroundColor=#ffffff;strokeColor=#2f6fb0;strokeWidth=1.6;endArrow=block;endFill=1;endSize=8;jumpStyle=arc;jumpSize=8;" edge="1" parent="p9-1" source="g10_p2" target="g10_p3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="g10_n1" value="Si tu proyecto todavía no tiene ninguna parcela familiar registrada, el visor te lo indica con un
        mensaje y desmarca la casilla automáticamente — no es un error." style="shape=note;size=14;html=1;fillColor=#fdeee6;strokeColor=#d95926;fontColor=#1f2933;fontSize=10;whiteSpace=wrap;align=left;spacing=6;" vertex="1" parent="p9-1"><mxGeometry x="220" y="578" width="1060" height="70" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="pag10" name="11 · Capas externas: sube tus archivos">
    <mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="p10-0"/>
        <mxCell id="p10-1" parent="p10-0"/>
        <mxCell id="n66" value="11 · Sube tus propios archivos al mapa" style="text;html=1;fontSize=26;fontStyle=1;fontColor=#1f2933;align=left;" vertex="1" parent="p10-1"><mxGeometry x="60" y="30" width="1380" height="34" as="geometry"/></mxCell>
        <mxCell id="n67" value="Además de lo registrado por WhatsApp, puedes cargar temporalmente tus propios archivos
        geográficos para compararlos visualmente con el catastro — GeoJSON, Shapefile, KML o KMZ." style="text;html=1;whiteSpace=wrap;fontSize=13;fontColor=#5b6470;align=left;" vertex="1" parent="p10-1"><mxGeometry x="60" y="68" width="1380" height="40" as="geometry"/></mxCell>
        <mxCell id="g11_inicio" value="En «Capa externa», clic en «Elegir archivo»" style="rounded=1;arcSize=50;html=1;fillColor=#7a5cc0;strokeColor=#7a5cc0;fontColor=#ffffff;fontStyle=1;fontSize=12;whiteSpace=wrap;" vertex="1" parent="p10-1"><mxGeometry x="490" y="160" width="520" height="56" as="geometry"/></mxCell>
        <mxCell id="g11_f0" value="&lt;b&gt;.geojson / .json&lt;/b&gt;&lt;br&gt;&lt;br&gt;Se dibuja directamente, sin ningún paso extra." style="rounded=0;html=1;fillColor=#f0ebfa;strokeColor=#7a5cc0;strokeWidth=1.5;fontColor=#1f2933;align=left;fontSize=11;whiteSpace=wrap;spacing=8;" vertex="1" parent="p10-1"><mxGeometry x="60" y="260" width="323" height="160" as="geometry"/></mxCell>
        <mxCell id="n68" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;fontColor=#3a3f44;labelBackgroundColor=#ffffff;strokeColor=#7a5cc0;strokeWidth=1.6;endArrow=block;endFill=1;endSize=8;jumpStyle=arc;jumpSize=8;" edge="1" parent="p10-1" source="g11_inicio" target="g11_f0"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="g11_f1" value="&lt;b&gt;.zip (Shapefile)&lt;/b&gt;&lt;br&gt;&lt;br&gt;Debe contener juntos los archivos .shp, .dbf y .shx del mismo shapefile — no los subas sueltos." style="rounded=0;html=1;fillColor=#f0ebfa;strokeColor=#7a5cc0;strokeWidth=1.5;fontColor=#1f2933;align=left;fontSize=11;whiteSpace=wrap;spacing=8;" vertex="1" parent="p10-1"><mxGeometry x="413" y="260" width="323" height="160" as="geometry"/></mxCell>
        <mxCell id="n69" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;fontColor=#3a3f44;labelBackgroundColor=#ffffff;strokeColor=#7a5cc0;strokeWidth=1.6;endArrow=block;endFill=1;endSize=8;jumpStyle=arc;jumpSize=8;" edge="1" parent="p10-1" source="g11_inicio" target="g11_f1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="g11_f2" value="&lt;b&gt;.kml&lt;/b&gt;&lt;br&gt;&lt;br&gt;Se dibuja directamente, igual que un GeoJSON." style="rounded=0;html=1;fillColor=#f0ebfa;strokeColor=#7a5cc0;strokeWidth=1.5;fontColor=#1f2933;align=left;fontSize=11;whiteSpace=wrap;spacing=8;" vertex="1" parent="p10-1"><mxGeometry x="765" y="260" width="323" height="160" as="geometry"/></mxCell>
        <mxCell id="n70" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;fontColor=#3a3f44;labelBackgroundColor=#ffffff;strokeColor=#7a5cc0;strokeWidth=1.6;endArrow=block;endFill=1;endSize=8;jumpStyle=arc;jumpSize=8;" edge="1" parent="p10-1" source="g11_inicio" target="g11_f2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="g11_f3" value="&lt;b&gt;.kmz&lt;/b&gt;&lt;br&gt;&lt;br&gt;Es un .kml comprimido — el visor lo descomprime solo y lo dibuja." style="rounded=0;html=1;fillColor=#f0ebfa;strokeColor=#7a5cc0;strokeWidth=1.5;fontColor=#1f2933;align=left;fontSize=11;whiteSpace=wrap;spacing=8;" vertex="1" parent="p10-1"><mxGeometry x="1118" y="260" width="323" height="160" as="geometry"/></mxCell>
        <mxCell id="n71" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;fontColor=#3a3f44;labelBackgroundColor=#ffffff;strokeColor=#7a5cc0;strokeWidth=1.6;endArrow=block;endFill=1;endSize=8;jumpStyle=arc;jumpSize=8;" edge="1" parent="p10-1" source="g11_inicio" target="g11_f3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="g11_fin" value="La capa aparece en el mapa en color morado" style="rounded=1;arcSize=50;html=1;fillColor=#199e70;strokeColor=#199e70;fontColor=#ffffff;fontStyle=1;fontSize=12;whiteSpace=wrap;" vertex="1" parent="p10-1"><mxGeometry x="470" y="480" width="560" height="60" as="geometry"/></mxCell>
        <mxCell id="n72" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;fontColor=#3a3f44;labelBackgroundColor=#ffffff;strokeColor=#7a5cc0;strokeWidth=1.6;endArrow=block;endFill=1;endSize=8;jumpStyle=arc;jumpSize=8;" edge="1" parent="p10-1" source="g11_f0" target="g11_fin"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="n73" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;fontColor=#3a3f44;labelBackgroundColor=#ffffff;strokeColor=#7a5cc0;strokeWidth=1.6;endArrow=block;endFill=1;endSize=8;jumpStyle=arc;jumpSize=8;" edge="1" parent="p10-1" source="g11_f1" target="g11_fin"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="n74" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;fontColor=#3a3f44;labelBackgroundColor=#ffffff;strokeColor=#7a5cc0;strokeWidth=1.6;endArrow=block;endFill=1;endSize=8;jumpStyle=arc;jumpSize=8;" edge="1" parent="p10-1" source="g11_f2" target="g11_fin"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="n75" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;fontColor=#3a3f44;labelBackgroundColor=#ffffff;strokeColor=#7a5cc0;strokeWidth=1.6;endArrow=block;endFill=1;endSize=8;jumpStyle=arc;jumpSize=8;" edge="1" parent="p10-1" source="g11_f3" target="g11_fin"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="g11_n1" value="El mapa hace zoom automático hacia la capa cargada. Solo puede haber una capa externa activa a la
        vez: al subir un archivo nuevo, reemplaza al anterior. El botón «Quitar capa» la retira cuando quieras." style="shape=note;size=14;html=1;fillColor=#eef0f2;strokeColor=#5b6470;fontColor=#1f2933;fontSize=10;whiteSpace=wrap;align=left;spacing=6;" vertex="1" parent="p10-1"><mxGeometry x="350" y="570" width="800" height="90" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="pag11" name="12 · Capas WMS">
    <mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="764" math="0" shadow="0">
      <root>
        <mxCell id="p11-0"/>
        <mxCell id="p11-1" parent="p11-0"/>
        <mxCell id="n76" value="12 · Conecta servicios WMS externos" style="text;html=1;fontSize=26;fontStyle=1;fontColor=#1f2933;align=left;" vertex="1" parent="p11-1"><mxGeometry x="60" y="30" width="1380" height="34" as="geometry"/></mxCell>
        <mxCell id="n77" value="Un WMS es un servicio de mapas que otra entidad publica en internet (por ejemplo, el IGAC
        o el IDEAM). El visor puede mostrar esas capas superpuestas sobre el catastro propio." style="text;html=1;whiteSpace=wrap;fontSize=13;fontColor=#5b6470;align=left;" vertex="1" parent="p11-1"><mxGeometry x="60" y="68" width="1380" height="40" as="geometry"/></mxCell>
        <mxCell id="g12_num0" value="1" style="rounded=1;arcSize=50;html=1;fillColor=#7a5cc0;strokeColor=#7a5cc0;fontColor=#ffffff;fontStyle=1;fontSize=12;whiteSpace=wrap;" vertex="1" parent="p11-1"><mxGeometry x="120" y="170" width="40" height="40" as="geometry"/></mxCell>
        <mxCell id="g12_num1" value="2" style="rounded=1;arcSize=50;html=1;fillColor=#7a5cc0;strokeColor=#7a5cc0;fontColor=#ffffff;fontStyle=1;fontSize=12;whiteSpace=wrap;" vertex="1" parent="p11-1"><mxGeometry x="120" y="272" width="40" height="40" as="geometry"/></mxCell>
        <mxCell id="g12_num2" value="3" style="rounded=1;arcSize=50;html=1;fillColor=#7a5cc0;strokeColor=#7a5cc0;fontColor=#ffffff;fontStyle=1;fontSize=12;whiteSpace=wrap;" vertex="1" parent="p11-1"><mxGeometry x="120" y="374" width="40" height="40" as="geometry"/></mxCell>
        <mxCell id="g12_num3" value="4" style="rounded=1;arcSize=50;html=1;fillColor=#7a5cc0;strokeColor=#7a5cc0;fontColor=#ffffff;fontStyle=1;fontSize=12;whiteSpace=wrap;" vertex="1" parent="p11-1"><mxGeometry x="120" y="476" width="40" height="40" as="geometry"/></mxCell>
        <mxCell id="g12_p0" value="&lt;b&gt;Pega la URL del servicio WMS&lt;/b&gt;&lt;br&gt;En el campo de texto de la sección «Capa WMS»." style="rounded=0;html=1;fillColor=#f0ebfa;strokeColor=#7a5cc0;strokeWidth=1.5;fontColor=#1f2933;align=left;fontSize=11;whiteSpace=wrap;spacing=8;" vertex="1" parent="p11-1"><mxGeometry x="220" y="170" width="1060" height="78" as="geometry"/></mxCell>
        <mxCell id="g12_p1" value="&lt;b&gt;(Opcional) Clic en «Ver capas disponibles»&lt;/b&gt;&lt;br&gt;El visor intenta consultar automáticamente qué capas ofrece ese servicio." style="rounded=0;html=1;fillColor=#f0ebfa;strokeColor=#7a5cc0;strokeWidth=1.5;fontColor=#1f2933;align=left;fontSize=11;whiteSpace=wrap;spacing=8;" vertex="1" parent="p11-1"><mxGeometry x="220" y="272" width="1060" height="78" as="geometry"/></mxCell>
        <mxCell id="n78" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;fontColor=#3a3f44;labelBackgroundColor=#ffffff;strokeColor=#7a5cc0;strokeWidth=1.6;endArrow=block;endFill=1;endSize=8;jumpStyle=arc;jumpSize=8;" edge="1" parent="p11-1" source="g12_p0" target="g12_p1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="g12_p2" value="&lt;b&gt;Elige una capa de la lista, o escribe su nombre a mano&lt;/b&gt;&lt;br&gt;Algunos servicios no permiten esta consulta automática por seguridad (CORS) — en ese caso, escribes el nombre directamente." style="rounded=0;html=1;fillColor=#f0ebfa;strokeColor=#7a5cc0;strokeWidth=1.5;fontColor=#1f2933;align=left;fontSize=11;whiteSpace=wrap;spacing=8;" vertex="1" parent="p11-1"><mxGeometry x="220" y="374" width="1060" height="78" as="geometry"/></mxCell>
        <mxCell id="n79" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;fontColor=#3a3f44;labelBackgroundColor=#ffffff;strokeColor=#7a5cc0;strokeWidth=1.6;endArrow=block;endFill=1;endSize=8;jumpStyle=arc;jumpSize=8;" edge="1" parent="p11-1" source="g12_p1" target="g12_p2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="g12_p3" value="&lt;b&gt;Clic en «Agregar capa»&lt;/b&gt;&lt;br&gt;Se suma al mapa como una capa más, y aparece en la lista de abajo con un botón para quitarla." style="rounded=0;html=1;fillColor=#f0ebfa;strokeColor=#7a5cc0;strokeWidth=1.5;fontColor=#1f2933;align=left;fontSize=11;whiteSpace=wrap;spacing=8;" vertex="1" parent="p11-1"><mxGeometry x="220" y="476" width="1060" height="78" as="geometry"/></mxCell>
        <mxCell id="n80" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;fontColor=#3a3f44;labelBackgroundColor=#ffffff;strokeColor=#7a5cc0;strokeWidth=1.6;endArrow=block;endFill=1;endSize=8;jumpStyle=arc;jumpSize=8;" edge="1" parent="p11-1" source="g12_p2" target="g12_p3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="g12_fin" value="Puedes agregar varias capas WMS a la vez" style="rounded=1;arcSize=50;html=1;fillColor=#199e70;strokeColor=#199e70;fontColor=#ffffff;fontStyle=1;fontSize=12;whiteSpace=wrap;" vertex="1" parent="p11-1"><mxGeometry x="220" y="578" width="1060" height="56" as="geometry"/></mxCell>
        <mxCell id="n81" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;fontColor=#3a3f44;labelBackgroundColor=#ffffff;strokeColor=#7a5cc0;strokeWidth=1.6;endArrow=block;endFill=1;endSize=8;jumpStyle=arc;jumpSize=8;" edge="1" parent="p11-1" source="g12_p3" target="g12_fin"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="g12_n1" value="Si una capa no carga, revisa que la URL y el nombre de la capa estén escritos exactamente como los
        dio el proveedor del servicio — el visor te avisa con un mensaje si detecta el error." style="shape=note;size=14;html=1;fillColor=#fdeee6;strokeColor=#d95926;fontColor=#1f2933;fontSize=10;whiteSpace=wrap;align=left;spacing=6;" vertex="1" parent="p11-1"><mxGeometry x="220" y="654" width="1060" height="70" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="pag12" name="13 · La ficha de detalle de un registro">
    <mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="660" math="0" shadow="0">
      <root>
        <mxCell id="p12-0"/>
        <mxCell id="p12-1" parent="p12-0"/>
        <mxCell id="n82" value="13 · La ficha de detalle de un registro" style="text;html=1;fontSize=26;fontStyle=1;fontColor=#1f2933;align=left;" vertex="1" parent="p12-1"><mxGeometry x="60" y="30" width="1380" height="34" as="geometry"/></mxCell>
        <mxCell id="n83" value="Al hacer clic en un punto del mapa o en un nombre de la lista, se abre esta ficha con toda
        la información que la comunidad fue registrando por WhatsApp." style="text;html=1;whiteSpace=wrap;fontSize=13;fontColor=#5b6470;align=left;" vertex="1" parent="p12-1"><mxGeometry x="60" y="68" width="1380" height="40" as="geometry"/></mxCell>
        <mxCell id="g13_s0" value="Encabezado: nombre de la comunidad, tipo y pueblo étnico" style="rounded=0;html=1;fillColor=#eaf1fa;strokeColor=#2f6fb0;strokeWidth=1.5;fontColor=#1f2933;align=left;fontSize=11;whiteSpace=wrap;spacing=8;" vertex="1" parent="p12-1"><mxGeometry x="60" y="170" width="670" height="70" as="geometry"/></mxCell>
        <mxCell id="g13_s1" value="Datos generales: ubicación, número de familias y personas" style="rounded=0;html=1;fillColor=#eaf1fa;strokeColor=#2f6fb0;strokeWidth=1.5;fontColor=#1f2933;align=left;fontSize=11;whiteSpace=wrap;spacing=8;" vertex="1" parent="p12-1"><mxGeometry x="770" y="170" width="670" height="70" as="geometry"/></mxCell>
        <mxCell id="g13_s2" value="Representante legal y autoridades de la comunidad" style="rounded=0;html=1;fillColor=#eaf1fa;strokeColor=#2f6fb0;strokeWidth=1.5;fontColor=#1f2933;align=left;fontSize=11;whiteSpace=wrap;spacing=8;" vertex="1" parent="p12-1"><mxGeometry x="60" y="260" width="670" height="70" as="geometry"/></mxCell>
        <mxCell id="g13_s3" value="Historia del territorio (texto o transcripción de audio)" style="rounded=0;html=1;fillColor=#eaf1fa;strokeColor=#2f6fb0;strokeWidth=1.5;fontColor=#1f2933;align=left;fontSize=11;whiteSpace=wrap;spacing=8;" vertex="1" parent="p12-1"><mxGeometry x="770" y="260" width="670" height="70" as="geometry"/></mxCell>
        <mxCell id="g13_s4" value="Derechos, restricciones y uso de la tierra" style="rounded=0;html=1;fillColor=#eaf1fa;strokeColor=#2f6fb0;strokeWidth=1.5;fontColor=#1f2933;align=left;fontSize=11;whiteSpace=wrap;spacing=8;" vertex="1" parent="p12-1"><mxGeometry x="60" y="350" width="670" height="70" as="geometry"/></mxCell>
        <mxCell id="g13_s5" value="Documentos legales, con las fotos que se hayan adjuntado" style="rounded=0;html=1;fillColor=#eaf1fa;strokeColor=#2f6fb0;strokeWidth=1.5;fontColor=#1f2933;align=left;fontSize=11;whiteSpace=wrap;spacing=8;" vertex="1" parent="p12-1"><mxGeometry x="770" y="350" width="670" height="70" as="geometry"/></mxCell>
        <mxCell id="g13_s6" value="Cartografía: mapas o planos, si la comunidad los aportó" style="rounded=0;html=1;fillColor=#eaf1fa;strokeColor=#2f6fb0;strokeWidth=1.5;fontColor=#1f2933;align=left;fontSize=11;whiteSpace=wrap;spacing=8;" vertex="1" parent="p12-1"><mxGeometry x="60" y="440" width="670" height="70" as="geometry"/></mxCell>
        <mxCell id="g13_s7" value="Validación comunitaria: cómo y cuándo se aprobó la información" style="rounded=0;html=1;fillColor=#eaf1fa;strokeColor=#2f6fb0;strokeWidth=1.5;fontColor=#1f2933;align=left;fontSize=11;whiteSpace=wrap;spacing=8;" vertex="1" parent="p12-1"><mxGeometry x="770" y="440" width="670" height="70" as="geometry"/></mxCell>
        <mxCell id="g13_n1" value="Las fotos se abren a pantalla completa al hacer clic sobre ellas. Si tu cuenta tiene rol de
        administradora, al final de la ficha aparece además un botón «Enviar mensaje al chatbot»
        (capítulo 18) para contactar directamente a esa comunidad." style="shape=note;size=14;html=1;fillColor=#fdeee6;strokeColor=#d95926;fontColor=#1f2933;fontSize=10;whiteSpace=wrap;align=left;spacing=6;" vertex="1" parent="p12-1"><mxGeometry x="60" y="530" width="1380" height="90" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="pag13" name="14 · Dashboard: estadísticas del proyecto">
    <mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="590" math="0" shadow="0">
      <root>
        <mxCell id="p13-0"/>
        <mxCell id="p13-1" parent="p13-0"/>
        <mxCell id="n84" value="14 · Dashboard: estadísticas del proyecto" style="text;html=1;fontSize=26;fontStyle=1;fontColor=#1f2933;align=left;" vertex="1" parent="p13-1"><mxGeometry x="60" y="30" width="1380" height="34" as="geometry"/></mxCell>
        <mxCell id="n85" value="Una vista de conjunto con cinco indicadores y tres gráficas, sin necesidad de filtrar nada
        en el mapa." style="text;html=1;whiteSpace=wrap;fontSize=13;fontColor=#5b6470;align=left;" vertex="1" parent="p13-1"><mxGeometry x="60" y="68" width="1380" height="40" as="geometry"/></mxCell>
        <mxCell id="n86" value="Indicadores (KPI)" style="text;html=1;fontSize=16;fontStyle=1;fontColor=#2f6fb0;align=left;" vertex="1" parent="p13-1"><mxGeometry x="60" y="150" width="600" height="26" as="geometry"/></mxCell>
        <mxCell id="g14_k0" value="Registros totales" style="rounded=1;arcSize=50;html=1;fillColor=#2f6fb0;strokeColor=#2f6fb0;fontColor=#ffffff;fontStyle=1;fontSize=12;whiteSpace=wrap;" vertex="1" parent="p13-1"><mxGeometry x="60" y="190" width="260" height="60" as="geometry"/></mxCell>
        <mxCell id="g14_k1" value="Personas registradas" style="rounded=1;arcSize=50;html=1;fillColor=#2f6fb0;strokeColor=#2f6fb0;fontColor=#ffffff;fontStyle=1;fontSize=12;whiteSpace=wrap;" vertex="1" parent="p13-1"><mxGeometry x="340" y="190" width="260" height="60" as="geometry"/></mxCell>
        <mxCell id="g14_k2" value="Familias registradas" style="rounded=1;arcSize=50;html=1;fillColor=#2f6fb0;strokeColor=#2f6fb0;fontColor=#ffffff;fontStyle=1;fontSize=12;whiteSpace=wrap;" vertex="1" parent="p13-1"><mxGeometry x="620" y="190" width="260" height="60" as="geometry"/></mxCell>
        <mxCell id="g14_k3" value="Esta semana" style="rounded=1;arcSize=50;html=1;fillColor=#2f6fb0;strokeColor=#2f6fb0;fontColor=#ffffff;fontStyle=1;fontSize=12;whiteSpace=wrap;" vertex="1" parent="p13-1"><mxGeometry x="900" y="190" width="260" height="60" as="geometry"/></mxCell>
        <mxCell id="g14_k4" value="Con GPS" style="rounded=1;arcSize=50;html=1;fillColor=#2f6fb0;strokeColor=#2f6fb0;fontColor=#ffffff;fontStyle=1;fontSize=12;whiteSpace=wrap;" vertex="1" parent="p13-1"><mxGeometry x="1180" y="190" width="260" height="60" as="geometry"/></mxCell>
        <mxCell id="n87" value="Gráficas" style="text;html=1;fontSize=16;fontStyle=1;fontColor=#2f6fb0;align=left;" vertex="1" parent="p13-1"><mxGeometry x="60" y="290" width="600" height="26" as="geometry"/></mxCell>
        <mxCell id="g14_g0" value="&lt;b&gt;Tipo de comunidad&lt;/b&gt;&lt;br&gt;&lt;br&gt;Gráfica de anillo (doughnut) — cuántos registros hay de cada tipo de comunidad." style="rounded=0;html=1;fillColor=#e8f6ef;strokeColor=#199e70;strokeWidth=1.5;fontColor=#1f2933;align=left;fontSize=11;whiteSpace=wrap;spacing=8;" vertex="1" parent="p13-1"><mxGeometry x="60" y="330" width="440" height="220" as="geometry"/></mxCell>
        <mxCell id="g14_g1" value="&lt;b&gt;Registros por departamento&lt;/b&gt;&lt;br&gt;&lt;br&gt;Barras horizontales — los 15 departamentos con más territorios registrados." style="rounded=0;html=1;fillColor=#e8f6ef;strokeColor=#199e70;strokeWidth=1.5;fontColor=#1f2933;align=left;fontSize=11;whiteSpace=wrap;spacing=8;" vertex="1" parent="p13-1"><mxGeometry x="530" y="330" width="440" height="220" as="geometry"/></mxCell>
        <mxCell id="g14_g2" value="&lt;b&gt;Registros en el tiempo&lt;/b&gt;&lt;br&gt;&lt;br&gt;Línea de área — cuántos registros se hicieron cada mes, en los últimos 24 meses." style="rounded=0;html=1;fillColor=#e8f6ef;strokeColor=#199e70;strokeWidth=1.5;fontColor=#1f2933;align=left;fontSize=11;whiteSpace=wrap;spacing=8;" vertex="1" parent="p13-1"><mxGeometry x="1000" y="330" width="440" height="220" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="pag14" name="15 · Timeline: la línea de tiempo">
    <mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="620" math="0" shadow="0">
      <root>
        <mxCell id="p14-0"/>
        <mxCell id="p14-1" parent="p14-0"/>
        <mxCell id="n88" value="15 · Timeline: la línea de tiempo de los registros" style="text;html=1;fontSize=26;fontStyle=1;fontColor=#1f2933;align=left;" vertex="1" parent="p14-1"><mxGeometry x="60" y="30" width="1380" height="34" as="geometry"/></mxCell>
        <mxCell id="n89" value="Una barra deslizante que te deja ver, mes a mes, cómo fue creciendo el registro territorial." style="text;html=1;whiteSpace=wrap;fontSize=13;fontColor=#5b6470;align=left;" vertex="1" parent="p14-1"><mxGeometry x="60" y="68" width="1380" height="40" as="geometry"/></mxCell>
        <mxCell id="g15_1" value="Clic en la pestaña «Timeline», arriba" style="rounded=1;arcSize=50;html=1;fillColor=#2f6fb0;strokeColor=#2f6fb0;fontColor=#ffffff;fontStyle=1;fontSize=12;whiteSpace=wrap;" vertex="1" parent="p14-1"><mxGeometry x="60" y="170" width="500" height="56" as="geometry"/></mxCell>
        <mxCell id="g15_2" value="Aparece una barra debajo del mapa, con un control deslizante que va desde el registro
        más antiguo hasta el más reciente." style="rounded=0;html=1;fillColor=#eaf1fa;strokeColor=#2f6fb0;strokeWidth=1.5;fontColor=#1f2933;align=left;fontSize=12;whiteSpace=wrap;spacing=8;" vertex="1" parent="p14-1"><mxGeometry x="60" y="260" width="900" height="90" as="geometry"/></mxCell>
        <mxCell id="g15_3" value="Al mover el control hacia la izquierda, el mapa y la lista muestran solo los registros hechos
        hasta esa fecha — como si retrocedieras en el tiempo." style="rounded=0;html=1;fillColor=#eaf1fa;strokeColor=#2f6fb0;strokeWidth=1.5;fontColor=#1f2933;align=left;fontSize=12;whiteSpace=wrap;spacing=8;" vertex="1" parent="p14-1"><mxGeometry x="60" y="380" width="900" height="90" as="geometry"/></mxCell>
        <mxCell id="n90" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;fontColor=#3a3f44;labelBackgroundColor=#ffffff;strokeColor=#2f6fb0;strokeWidth=1.6;endArrow=block;endFill=1;endSize=8;jumpStyle=arc;jumpSize=8;" edge="1" parent="p14-1" source="g15_1" target="g15_2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="n91" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;fontColor=#3a3f44;labelBackgroundColor=#ffffff;strokeColor=#2f6fb0;strokeWidth=1.6;endArrow=block;endFill=1;endSize=8;jumpStyle=arc;jumpSize=8;" edge="1" parent="p14-1" source="g15_2" target="g15_3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="g15_n1" value="Mover el control hasta el final («Todo») vuelve a mostrar todos los registros, sin ningún filtro
        de fecha aplicado." style="shape=note;size=14;html=1;fillColor=#fdeee6;strokeColor=#d95926;fontColor=#1f2933;fontSize=10;whiteSpace=wrap;align=left;spacing=6;" vertex="1" parent="p14-1"><mxGeometry x="60" y="500" width="900" height="80" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="pag15" name="16 · Alertas automáticas">
    <mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="820" math="0" shadow="0">
      <root>
        <mxCell id="p15-0"/>
        <mxCell id="p15-1" parent="p15-0"/>
        <mxCell id="n92" value="16 · Alertas automáticas" style="text;html=1;fontSize=26;fontStyle=1;fontColor=#1f2933;align=left;" vertex="1" parent="p15-1"><mxGeometry x="60" y="30" width="1380" height="34" as="geometry"/></mxCell>
        <mxCell id="n93" value="El visor revisa la información registrada y avisa, con el ícono 🔔 de la barra superior,
        situaciones que conviene mirar con más cuidado." style="text;html=1;whiteSpace=wrap;fontSize=13;fontColor=#5b6470;align=left;" vertex="1" parent="p15-1"><mxGeometry x="60" y="68" width="1380" height="40" as="geometry"/></mxCell>
        <mxCell id="g16_sev0" value="ALTA" style="rounded=1;arcSize=50;html=1;fillColor=#c0392b;strokeColor=#c0392b;fontColor=#ffffff;fontStyle=1;fontSize=12;whiteSpace=wrap;" vertex="1" parent="p15-1"><mxGeometry x="60" y="160" width="110" height="90" as="geometry"/></mxCell>
        <mxCell id="g16_p0" value="&lt;b&gt;Inconsistencia de género&lt;/b&gt;&lt;br&gt;Las mujeres y hombres registrados suman más que el total de personas declarado." style="rounded=0;html=1;fillColor=#fbeae8;strokeColor=#c0392b;strokeWidth=1.5;fontColor=#1f2933;align=left;fontSize=11;whiteSpace=wrap;spacing=8;" vertex="1" parent="p15-1"><mxGeometry x="190" y="160" width="1250" height="90" as="geometry"/></mxCell>
        <mxCell id="g16_sev1" value="ALTA" style="rounded=1;arcSize=50;html=1;fillColor=#c0392b;strokeColor=#c0392b;fontColor=#ffffff;fontStyle=1;fontSize=12;whiteSpace=wrap;" vertex="1" parent="p15-1"><mxGeometry x="60" y="270" width="110" height="90" as="geometry"/></mxCell>
        <mxCell id="g16_p1" value="&lt;b&gt;Posible duplicado&lt;/b&gt;&lt;br&gt;Dos o más registros con el mismo nombre de comunidad." style="rounded=0;html=1;fillColor=#fbeae8;strokeColor=#c0392b;strokeWidth=1.5;fontColor=#1f2933;align=left;fontSize=11;whiteSpace=wrap;spacing=8;" vertex="1" parent="p15-1"><mxGeometry x="190" y="270" width="1250" height="90" as="geometry"/></mxCell>
        <mxCell id="g16_sev2" value="MEDIA" style="rounded=1;arcSize=50;html=1;fillColor=#d95926;strokeColor=#d95926;fontColor=#ffffff;fontStyle=1;fontSize=12;whiteSpace=wrap;" vertex="1" parent="p15-1"><mxGeometry x="60" y="380" width="110" height="90" as="geometry"/></mxCell>
        <mxCell id="g16_p2" value="&lt;b&gt;Sin coordenadas GPS&lt;/b&gt;&lt;br&gt;Comunidades registradas sin ubicación geográfica." style="rounded=0;html=1;fillColor=#fdeee6;strokeColor=#d95926;strokeWidth=1.5;fontColor=#1f2933;align=left;fontSize=11;whiteSpace=wrap;spacing=8;" vertex="1" parent="p15-1"><mxGeometry x="190" y="380" width="1250" height="90" as="geometry"/></mxCell>
        <mxCell id="g16_sev3" value="BAJA" style="rounded=1;arcSize=50;html=1;fillColor=#2f6fb0;strokeColor=#2f6fb0;fontColor=#ffffff;fontStyle=1;fontSize=12;whiteSpace=wrap;" vertex="1" parent="p15-1"><mxGeometry x="60" y="490" width="110" height="90" as="geometry"/></mxCell>
        <mxCell id="g16_p3" value="&lt;b&gt;Área atípica&lt;/b&gt;&lt;br&gt;El área del acto administrativo supera las 200.000 hectáreas — posible error de digitación." style="rounded=0;html=1;fillColor=#eaf1fa;strokeColor=#2f6fb0;strokeWidth=1.5;fontColor=#1f2933;align=left;fontSize=11;whiteSpace=wrap;spacing=8;" vertex="1" parent="p15-1"><mxGeometry x="190" y="490" width="1250" height="90" as="geometry"/></mxCell>
        <mxCell id="g16_sev4" value="BAJA" style="rounded=1;arcSize=50;html=1;fillColor=#2f6fb0;strokeColor=#2f6fb0;fontColor=#ffffff;fontStyle=1;fontSize=12;whiteSpace=wrap;" vertex="1" parent="p15-1"><mxGeometry x="60" y="600" width="110" height="90" as="geometry"/></mxCell>
        <mxCell id="g16_p4" value="&lt;b&gt;Validación pendiente&lt;/b&gt;&lt;br&gt;Registros cuya validación comunitaria todavía está en «Pendiente»." style="rounded=0;html=1;fillColor=#eaf1fa;strokeColor=#2f6fb0;strokeWidth=1.5;fontColor=#1f2933;align=left;fontSize=11;whiteSpace=wrap;spacing=8;" vertex="1" parent="p15-1"><mxGeometry x="190" y="600" width="1250" height="90" as="geometry"/></mxCell>
        <mxCell id="g16_n1" value="Dale clic a una alerta para abrir directamente la ficha del registro afectado. Las alertas se
        ordenan mostrando primero las de severidad alta." style="shape=note;size=14;html=1;fillColor=#eef0f2;strokeColor=#5b6470;fontColor=#1f2933;fontSize=10;whiteSpace=wrap;align=left;spacing=6;" vertex="1" parent="p15-1"><mxGeometry x="60" y="710" width="1380" height="70" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="pag16" name="17 · Exportar información">
    <mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="580" math="0" shadow="0">
      <root>
        <mxCell id="p16-0"/>
        <mxCell id="p16-1" parent="p16-0"/>
        <mxCell id="n94" value="17 · Exportar información: CSV, Excel y PDF" style="text;html=1;fontSize=26;fontStyle=1;fontColor=#1f2933;align=left;" vertex="1" parent="p16-1"><mxGeometry x="60" y="30" width="1380" height="34" as="geometry"/></mxCell>
        <mxCell id="n95" value="Los tres formatos respetan los filtros que tengas aplicados en ese momento en el panel
        izquierdo — conviene filtrar primero, y exportar después." style="text;html=1;whiteSpace=wrap;fontSize=13;fontColor=#5b6470;align=left;" vertex="1" parent="p16-1"><mxGeometry x="60" y="68" width="1380" height="40" as="geometry"/></mxCell>
        <mxCell id="g17_c0" value="&lt;b&gt;CSV&lt;/b&gt;&lt;br&gt;&lt;br&gt;Un archivo de texto plano con una fila por registro y todas sus columnas — ideal para abrir en cualquier programa de hojas de cálculo." style="rounded=0;html=1;fillColor=#eaf1fa;strokeColor=#2f6fb0;strokeWidth=1.5;fontColor=#1f2933;align=left;fontSize=11;whiteSpace=wrap;spacing=8;" vertex="1" parent="p16-1"><mxGeometry x="60" y="170" width="440" height="260" as="geometry"/></mxCell>
        <mxCell id="g17_c1" value="&lt;b&gt;Excel&lt;/b&gt;&lt;br&gt;&lt;br&gt;Un archivo .xlsx con dos hojas: «Registros» (con formato y colores) y «Resumen», con el total exportado y los filtros aplicados." style="rounded=0;html=1;fillColor=#eaf1fa;strokeColor=#2f6fb0;strokeWidth=1.5;fontColor=#1f2933;align=left;fontSize=11;whiteSpace=wrap;spacing=8;" vertex="1" parent="p16-1"><mxGeometry x="530" y="170" width="440" height="260" as="geometry"/></mxCell>
        <mxCell id="g17_c2" value="&lt;b&gt;PDF&lt;/b&gt;&lt;br&gt;&lt;br&gt;Un informe con portada, indicadores, un mapa con los puntos, gráficas de distribución, y una tabla con los registros (hasta 500 filas)." style="rounded=0;html=1;fillColor=#eaf1fa;strokeColor=#2f6fb0;strokeWidth=1.5;fontColor=#1f2933;align=left;fontSize=11;whiteSpace=wrap;spacing=8;" vertex="1" parent="p16-1"><mxGeometry x="1000" y="170" width="440" height="260" as="geometry"/></mxCell>
        <mxCell id="g17_n1" value="Los botones de CSV y Excel están en la barra superior del visor (íconos 📥 y 📊). El PDF se genera
        desde el mismo sistema, con el mismo formato de filtros." style="shape=note;size=14;html=1;fillColor=#fdeee6;strokeColor=#d95926;fontColor=#1f2933;fontSize=10;whiteSpace=wrap;align=left;spacing=6;" vertex="1" parent="p16-1"><mxGeometry x="60" y="470" width="1380" height="70" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="pag17" name="18 · Mensajes y notificaciones en tiempo real">
    <mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="540" math="0" shadow="0">
      <root>
        <mxCell id="p17-0"/>
        <mxCell id="p17-1" parent="p17-0"/>
        <mxCell id="n96" value="18 · Enviar mensajes desde el visor, y notificaciones en tiempo real" style="text;html=1;fontSize=26;fontStyle=1;fontColor=#1f2933;align=left;" vertex="1" parent="p17-1"><mxGeometry x="60" y="30" width="1380" height="34" as="geometry"/></mxCell>
        <mxCell id="n97" value="Dos funciones exclusivas del rol de administradora, para mantener contacto con las
        comunidades y ver quién más está usando el visor en este momento." style="text;html=1;whiteSpace=wrap;fontSize=13;fontColor=#5b6470;align=left;" vertex="1" parent="p17-1"><mxGeometry x="60" y="68" width="1380" height="40" as="geometry"/></mxCell>
        <mxCell id="g18_col1" value="" style="rounded=1;html=1;fillColor=none;strokeColor=#0f766e;strokeWidth=1.5;dashed=1;verticalAlign=top;fontColor=#0f766e;" vertex="1" parent="p17-1"><mxGeometry x="60" y="160" width="660" height="340" as="geometry"/></mxCell>
        <mxCell id="n98" value="💬 Enviar mensaje al chatbot (solo admin)" style="text;html=1;fontSize=13;fontStyle=1;fontColor=#0f766e;align=left;spacingLeft=10;" vertex="1" parent="p17-1"><mxGeometry x="68" y="138" width="644" height="20" as="geometry"/></mxCell>
        <mxCell id="g18_a1" value="1. Clic en el ícono 💬 de la barra superior" style="rounded=0;html=1;fillColor=#e6f4f1;strokeColor=#0f766e;strokeWidth=1.5;fontColor=#1f2933;align=left;fontSize=12;whiteSpace=wrap;spacing=8;" vertex="1" parent="p17-1"><mxGeometry x="90" y="190" width="600" height="60" as="geometry"/></mxCell>
        <mxCell id="g18_a2" value="2. Escribe el número de WhatsApp y el mensaje" style="rounded=0;html=1;fillColor=#e6f4f1;strokeColor=#0f766e;strokeWidth=1.5;fontColor=#1f2933;align=left;fontSize=12;whiteSpace=wrap;spacing=8;" vertex="1" parent="p17-1"><mxGeometry x="90" y="270" width="600" height="80" as="geometry"/></mxCell>
        <mxCell id="g18_a3" value="3. Clic en «Enviar» — el mensaje sale desde el chatbot hacia ese número" style="rounded=0;html=1;fillColor=#e6f4f1;strokeColor=#0f766e;strokeWidth=1.5;fontColor=#1f2933;align=left;fontSize=12;whiteSpace=wrap;spacing=8;" vertex="1" parent="p17-1"><mxGeometry x="90" y="370" width="600" height="100" as="geometry"/></mxCell>
        <mxCell id="n99" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;fontColor=#3a3f44;labelBackgroundColor=#ffffff;strokeColor=#0f766e;strokeWidth=1.6;endArrow=block;endFill=1;endSize=8;jumpStyle=arc;jumpSize=8;" edge="1" parent="p17-1" source="g18_a1" target="g18_a2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="n100" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;fontColor=#3a3f44;labelBackgroundColor=#ffffff;strokeColor=#0f766e;strokeWidth=1.6;endArrow=block;endFill=1;endSize=8;jumpStyle=arc;jumpSize=8;" edge="1" parent="p17-1" source="g18_a2" target="g18_a3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="g18_col2" value="" style="rounded=1;html=1;fillColor=none;strokeColor=#5b6470;strokeWidth=1.5;dashed=1;verticalAlign=top;fontColor=#5b6470;" vertex="1" parent="p17-1"><mxGeometry x="780" y="160" width="660" height="340" as="geometry"/></mxCell>
        <mxCell id="n101" value="🟢 Notificaciones en tiempo real" style="text;html=1;fontSize=13;fontStyle=1;fontColor=#5b6470;align=left;spacingLeft=10;" vertex="1" parent="p17-1"><mxGeometry x="788" y="138" width="644" height="20" as="geometry"/></mxCell>
        <mxCell id="g18_b1" value="El punto junto a tu nombre indica si estás conectado en vivo, y cuántas personas más están viendo el visor ahora" style="rounded=0;html=1;fillColor=#eef0f2;strokeColor=#5b6470;strokeWidth=1.5;fontColor=#1f2933;align=left;fontSize=12;whiteSpace=wrap;spacing=8;" vertex="1" parent="p17-1"><mxGeometry x="810" y="190" width="600" height="90" as="geometry"/></mxCell>
        <mxCell id="g18_b2" value="Cuando la comunidad completa un registro nuevo por WhatsApp, aparece un aviso automático y el mapa se actualiza solo, sin recargar la página" style="rounded=0;html=1;fillColor=#eef0f2;strokeColor=#5b6470;strokeWidth=1.5;fontColor=#1f2933;align=left;fontSize=12;whiteSpace=wrap;spacing=8;" vertex="1" parent="p17-1"><mxGeometry x="810" y="300" width="600" height="100" as="geometry"/></mxCell>
        <mxCell id="n102" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;fontColor=#3a3f44;labelBackgroundColor=#ffffff;strokeColor=#5b6470;strokeWidth=1.6;endArrow=block;endFill=1;endSize=8;jumpStyle=arc;jumpSize=8;" edge="1" parent="p17-1" source="g18_b1" target="g18_b2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="pag18" name="19 · Preguntas frecuentes y ayuda">
    <mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="840" math="0" shadow="0">
      <root>
        <mxCell id="p18-0"/>
        <mxCell id="p18-1" parent="p18-0"/>
        <mxCell id="n103" value="19 · Preguntas frecuentes y ayuda" style="text;html=1;fontSize=26;fontStyle=1;fontColor=#1f2933;align=left;" vertex="1" parent="p18-1"><mxGeometry x="60" y="30" width="1580" height="34" as="geometry"/></mxCell>
        <mxCell id="n104" value="Un resumen rápido de qué hacer ante los problemas más comunes, tanto en WhatsApp
        como en el visor." style="text;html=1;whiteSpace=wrap;fontSize=13;fontColor=#5b6470;align=left;" vertex="1" parent="p18-1"><mxGeometry x="60" y="68" width="1580" height="40" as="geometry"/></mxCell>
        <mxCell id="g19_centro" value="¿Cuál es tu
        situación?" style="rhombus;html=1;fillColor=#eef0f2;strokeColor=#5b6470;strokeWidth=1.5;fontColor=#1f2933;fontSize=11;whiteSpace=wrap;" vertex="1" parent="p18-1"><mxGeometry x="690" y="150" width="320" height="80" as="geometry"/></mxCell>
        <mxCell id="g19_r0" value="&lt;b&gt;El bot no me responde en WhatsApp&lt;/b&gt;&lt;br&gt;&lt;br&gt;Revisa que tengas señal o datos móviles. Si sigue sin responder, avísale a Katherine: puede que el servidor esté apagado." style="rounded=0;html=1;fillColor=#e6f4f1;strokeColor=#0f766e;strokeWidth=1.5;fontColor=#1f2933;align=left;fontSize=11;whiteSpace=wrap;spacing=8;" vertex="1" parent="p18-1"><mxGeometry x="60" y="300" width="507" height="220" as="geometry"/></mxCell>
        <mxCell id="n105" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;fontColor=#3a3f44;labelBackgroundColor=#ffffff;strokeColor=#5b6470;strokeWidth=1.6;endArrow=block;endFill=1;endSize=8;jumpStyle=arc;jumpSize=8;" edge="1" parent="p18-1" source="g19_centro" target="g19_r0"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="g19_r1" value="&lt;b&gt;No puedo iniciar sesión en el visor&lt;/b&gt;&lt;br&gt;&lt;br&gt;Confirma usuario y contraseña. Si la olvidaste, pídele a otra persona administradora que te la restablezca." style="rounded=0;html=1;fillColor=#e6f4f1;strokeColor=#0f766e;strokeWidth=1.5;fontColor=#1f2933;align=left;fontSize=11;whiteSpace=wrap;spacing=8;" vertex="1" parent="p18-1"><mxGeometry x="597" y="300" width="507" height="220" as="geometry"/></mxCell>
        <mxCell id="n106" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;fontColor=#3a3f44;labelBackgroundColor=#ffffff;strokeColor=#5b6470;strokeWidth=1.6;endArrow=block;endFill=1;endSize=8;jumpStyle=arc;jumpSize=8;" edge="1" parent="p18-1" source="g19_centro" target="g19_r1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="g19_r2" value="&lt;b&gt;No encuentro un registro en el mapa&lt;/b&gt;&lt;br&gt;&lt;br&gt;Revisa los filtros aplicados (departamento, tipo, fechas) — puede que estén ocultando el resultado. Dale clic en «Limpiar»." style="rounded=0;html=1;fillColor=#e6f4f1;strokeColor=#0f766e;strokeWidth=1.5;fontColor=#1f2933;align=left;fontSize=11;whiteSpace=wrap;spacing=8;" vertex="1" parent="p18-1"><mxGeometry x="1133" y="300" width="507" height="220" as="geometry"/></mxCell>
        <mxCell id="n107" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;fontColor=#3a3f44;labelBackgroundColor=#ffffff;strokeColor=#5b6470;strokeWidth=1.6;endArrow=block;endFill=1;endSize=8;jumpStyle=arc;jumpSize=8;" edge="1" parent="p18-1" source="g19_centro" target="g19_r2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="g19_r3" value="&lt;b&gt;Necesito corregir un dato ya guardado&lt;/b&gt;&lt;br&gt;&lt;br&gt;La comunidad no puede editarlo desde WhatsApp una vez guardado: contacta a Katherine, quien puede ajustarlo directamente en la base de datos." style="rounded=0;html=1;fillColor=#e6f4f1;strokeColor=#0f766e;strokeWidth=1.5;fontColor=#1f2933;align=left;fontSize=11;whiteSpace=wrap;spacing=8;" vertex="1" parent="p18-1"><mxGeometry x="60" y="550" width="507" height="220" as="geometry"/></mxCell>
        <mxCell id="n108" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;fontColor=#3a3f44;labelBackgroundColor=#ffffff;strokeColor=#5b6470;strokeWidth=1.6;endArrow=block;endFill=1;endSize=8;jumpStyle=arc;jumpSize=8;" edge="1" parent="p18-1" source="g19_centro" target="g19_r3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="g19_r4" value="&lt;b&gt;Subí un archivo y no aparece en el mapa&lt;/b&gt;&lt;br&gt;&lt;br&gt;Revisa que el shapefile esté comprimido en un .zip con .shp+.dbf+.shx juntos, y que el KML/KMZ no esté dañado." style="rounded=0;html=1;fillColor=#e6f4f1;strokeColor=#0f766e;strokeWidth=1.5;fontColor=#1f2933;align=left;fontSize=11;whiteSpace=wrap;spacing=8;" vertex="1" parent="p18-1"><mxGeometry x="597" y="550" width="507" height="220" as="geometry"/></mxCell>
        <mxCell id="n109" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;fontColor=#3a3f44;labelBackgroundColor=#ffffff;strokeColor=#5b6470;strokeWidth=1.6;endArrow=block;endFill=1;endSize=8;jumpStyle=arc;jumpSize=8;" edge="1" parent="p18-1" source="g19_centro" target="g19_r4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="g19_r5" value="&lt;b&gt;Una capa WMS no carga&lt;/b&gt;&lt;br&gt;&lt;br&gt;Confirma que la URL y el nombre de la capa sean exactamente los que indica el proveedor del servicio." style="rounded=0;html=1;fillColor=#e6f4f1;strokeColor=#0f766e;strokeWidth=1.5;fontColor=#1f2933;align=left;fontSize=11;whiteSpace=wrap;spacing=8;" vertex="1" parent="p18-1"><mxGeometry x="1133" y="550" width="507" height="220" as="geometry"/></mxCell>
        <mxCell id="n110" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;fontColor=#3a3f44;labelBackgroundColor=#ffffff;strokeColor=#5b6470;strokeWidth=1.6;endArrow=block;endFill=1;endSize=8;jumpStyle=arc;jumpSize=8;" edge="1" parent="p18-1" source="g19_centro" target="g19_r5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
