        <mxCell id="n153" value="No hay servidores en la nube propios del proyecto: todo el sistema corre en un solo computador, el de Katherine. Un túnel es lo único que lo hace visible desde afuera." style="text;html=1;whiteSpace=wrap;fontSize=13;fontColor=#5b6470;align=left;" vertex="1" parent="p8-1"><mxGeometry x="60" y="68" width="1780" height="40" as="geometry"/></mxCell>
