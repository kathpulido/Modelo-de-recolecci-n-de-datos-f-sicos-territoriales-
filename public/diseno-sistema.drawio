  <diagram id="pag4" name="5 · Flujo general de la conversación">
    <mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1320" pageHeight="4035" math="0" shadow="0">
      <root>
        <mxCell id="p4-0"/>
        <mxCell id="p4-1" parent="p4-0"/>
        <mxCell id="n62" value="El recorrido completo de una conversación" style="text;html=1;fontSize=26;fontStyle=1;fontColor=#1f2933;align=left;" vertex="1" parent="p4-1"><mxGeometry x="60" y="30" width="1200" height="34" as="geometry"/></mxCell>
        <mxCell id="n63" value="Cada caja verde es un módulo de preguntas; los rombos son los puntos donde el bot decide sola qué preguntar después. El orden exacto de algunas preguntas se ajusta según lo que ya se sabe — por ejemplo, si el GPS ya dio el municipio, no se vuelve a preguntar." style="text;html=1;whiteSpace=wrap;fontSize=13;fontColor=#5b6470;align=left;" vertex="1" parent="p4-1"><mxGeometry x="60" y="68" width="1200" height="40" as="geometry"/></mxCell>
        <mxCell id="t0" value="La persona escribe &quot;hola&quot;, &quot;inicio&quot; o &quot;registrar&quot;" style="rounded=1;arcSize=50;html=1;fillColor=#0f766e;strokeColor=#0f766e;fontColor=#ffffff;fontStyle=1;fontSize=12;whiteSpace=wrap;" vertex="1" parent="p4-1"><mxGeometry x="110" y="140" width="520" height="70" as="geometry"/></mxCell>
        <mxCell id="m0c" value="MÓDULO 0C — Consentimiento y bienvenida
        Explica para qué es el registro y pide autorización antes de continuar" style="rounded=0;html=1;fillColor=#e6f4f1;strokeColor=#0f766e;strokeWidth=1.5;fontColor=#1f2933;align=center;fontSize=12;whiteSpace=wrap;spacing=8;" vertex="1" parent="p4-1"><mxGeometry x="110" y="265" width="520" height="100" as="geometry"/></mxCell>
        <mxCell id="m0b" value="MÓDULO 0B — Modo online / offline
        ¿hay datos móviles ahora mismo?" style="rounded=0;html=1;fillColor=#e6f4f1;strokeColor=#0f766e;strokeWidth=1.5;fontColor=#1f2933;align=center;fontSize=12;whiteSpace=wrap;spacing=8;" vertex="1" parent="p4-1"><mxGeometry x="110" y="420" width="520" height="90" as="geometry"/></mxCell>
        <mxCell id="m0a" value="MÓDULO 0A — Preferencia de audio
        ¿responder por texto o por nota de voz?" style="rounded=0;html=1;fillColor=#e6f4f1;strokeColor=#0f766e;strokeWidth=1.5;fontColor=#1f2933;align=center;fontSize=12;whiteSpace=wrap;spacing=8;" vertex="1" parent="p4-1"><mxGeometry x="110" y="565" width="520" height="90" as="geometry"/></mxCell>
        <mxCell id="d0d" value="MÓDULO 0D
        ¿Se está levantando el territorio
        colectivo completo o la parcela
        de una familia dentro de él?" style="rhombus;html=1;fillColor=#fdeee6;strokeColor=#d95926;strokeWidth=1.5;fontColor=#1f2933;fontSize=11;whiteSpace=wrap;" vertex="1" parent="p4-1"><mxGeometry x="110" y="710" width="520" height="150" as="geometry"/></mxCell>
        <mxCell id="m0e" value="MÓDULO 0E — Buscar territorio
        ¿A cuál territorio ya registrado pertenece esta parcela?" style="rounded=0;html=1;fillColor=#e6f4f1;strokeColor=#0f766e;strokeWidth=1.5;fontColor=#1f2933;align=center;fontSize=12;whiteSpace=wrap;spacing=8;" vertex="1" parent="p4-1"><mxGeometry x="700" y="720" width="480" height="100" as="geometry"/></mxCell>
        <mxCell id="ubic" value="Ubicación del territorio
        se pide compartir la ubicación de WhatsApp" style="rounded=0;html=1;fillColor=#e6f4f1;strokeColor=#0f766e;strokeWidth=1.5;fontColor=#1f2933;align=center;fontSize=12;fontStyle=1;whiteSpace=wrap;spacing=8;" vertex="1" parent="p4-1"><mxGeometry x="110" y="930" width="520" height="100" as="geometry"/></mxCell>
        <mxCell id="dgps" value="¿Compartió la ubicación
        y Nominatim reconoció
        el municipio?" style="rhombus;html=1;fillColor=#fdeee6;strokeColor=#d95926;strokeWidth=1.5;fontColor=#1f2933;fontSize=11;whiteSpace=wrap;" vertex="1" parent="p4-1"><mxGeometry x="110" y="1085" width="520" height="150" as="geometry"/></mxCell>
        <mxCell id="m4b" value="MÓDULO 4B — A mano
        sin GPS: se pregunta departamento,
        municipio y vereda directamente" style="rounded=0;html=1;fillColor=#e6f4f1;strokeColor=#0f766e;strokeWidth=1.5;fontColor=#1f2933;align=center;fontSize=12;whiteSpace=wrap;spacing=8;" vertex="1" parent="p4-1"><mxGeometry x="700" y="1095" width="480" height="130" as="geometry"/></mxCell>
        <mxCell id="dver" value="¿Nominatim también
        reconoció la vereda?" style="rhombus;html=1;fillColor=#fdeee6;strokeColor=#d95926;strokeWidth=1.5;fontColor=#1f2933;fontSize=11;whiteSpace=wrap;" vertex="1" parent="p4-1"><mxGeometry x="110" y="1305" width="520" height="140" as="geometry"/></mxCell>
        <mxCell id="vereda" value="Se pregunta la vereda
        (una sola pregunta)" style="rounded=0;html=1;fillColor=#e6f4f1;strokeColor=#0f766e;strokeWidth=1.5;fontColor=#1f2933;align=center;fontSize=12;whiteSpace=wrap;spacing=8;" vertex="1" parent="p4-1"><mxGeometry x="700" y="1310" width="480" height="90" as="geometry"/></mxCell>
        <mxCell id="coch" value="CORREGIMIENTO — ¿pertenece a alguno?
        (nivel intermedio entre municipio y vereda)" style="rounded=0;html=1;fillColor=#e6f4f1;strokeColor=#0f766e;strokeWidth=1.5;fontColor=#1f2933;align=center;fontSize=12;whiteSpace=wrap;spacing=8;" vertex="1" parent="p4-1"><mxGeometry x="110" y="1515" width="520" height="90" as="geometry"/></mxCell>
        <mxCell id="nota_perim" value="A partir de aquí el perímetro es obligatorio:
        no se puede seguir sin dibujar el croquis o caminar el lindero." style="shape=note;size=14;html=1;fillColor=#fdeee6;strokeColor=#d95926;fontColor=#1f2933;fontSize=10;whiteSpace=wrap;align=left;spacing=6;" vertex="1" parent="p4-1"><mxGeometry x="110" y="1660" width="520" height="90" as="geometry"/></mxCell>
        <mxCell id="perim" value="MÓDULO 4C — Captura del perímetro
        Croquis dibujado o recorrido GPS caminado — ocurre fuera de
        WhatsApp, en el navegador (croquis.html / recorrido.html)" style="shape=process;html=1;fillColor=#e6f4f1;strokeColor=#0f766e;strokeWidth=1.5;fontColor=#1f2933;fontSize=12;whiteSpace=wrap;" vertex="1" parent="p4-1"><mxGeometry x="110" y="1790" width="520" height="120" as="geometry"/></mxCell>
        <mxCell id="dfam" value="¿Lo que se acaba de
        capturar es una parcela
        familiar?" style="rhombus;html=1;fillColor=#fdeee6;strokeColor=#d95926;strokeWidth=1.5;fontColor=#1f2933;fontSize=11;whiteSpace=wrap;" vertex="1" parent="p4-1"><mxGeometry x="110" y="1950" width="520" height="150" as="geometry"/></mxCell>
        <mxCell id="mf" value="MÓDULO F — La familia que ocupa la parcela
        jefe de hogar, cuántas personas, hombres y mujeres,
        origen de la asignación, documento" style="rounded=0;html=1;fillColor=#e6f4f1;strokeColor=#0f766e;strokeWidth=1.5;fontColor=#1f2933;align=center;fontSize=12;whiteSpace=wrap;spacing=8;" vertex="1" parent="p4-1"><mxGeometry x="700" y="1960" width="480" height="130" as="geometry"/></mxCell>
        <mxCell id="cf" value="CIERRE FAMILIAR
        guarda la parcela y ofrece encadenar
        otra familia del mismo territorio" style="rounded=0;html=1;fillColor=#e8f6ef;strokeColor=#199e70;strokeWidth=1.5;fontColor=#1f2933;align=center;fontSize=12;fontStyle=1;whiteSpace=wrap;spacing=8;" vertex="1" parent="p4-1"><mxGeometry x="700" y="2130" width="480" height="120" as="geometry"/></mxCell>
        <mxCell id="tf" value="Parcela familiar guardada ✅" style="rounded=1;arcSize=50;html=1;fillColor=#0f766e;strokeColor=#0f766e;fontColor=#ffffff;fontStyle=1;fontSize=12;whiteSpace=wrap;" vertex="1" parent="p4-1"><mxGeometry x="700" y="2290" width="480" height="70" as="geometry"/></mxCell>
        <mxCell id="m1" value="MÓDULO 1 — Identificación de la comunidad
        nombre, pueblo, tipo de comunidad, cuántas familias" style="rounded=0;html=1;fillColor=#e6f4f1;strokeColor=#0f766e;strokeWidth=1.5;fontColor=#1f2933;align=center;fontSize=12;whiteSpace=wrap;spacing=8;" vertex="1" parent="p4-1"><mxGeometry x="110" y="2170" width="520" height="90" as="geometry"/></mxCell>
        <mxCell id="m2" value="MÓDULO 2 — Representante legal y autoridades" style="rounded=0;html=1;fillColor=#e6f4f1;strokeColor=#0f766e;strokeWidth=1.5;fontColor=#1f2933;align=center;fontSize=12;whiteSpace=wrap;spacing=8;" vertex="1" parent="p4-1"><mxGeometry x="110" y="2315" width="520" height="90" as="geometry"/></mxCell>
        <mxCell id="m3" value="MÓDULO 3 — Historia del territorio
        se puede responder hablando (se transcribe)" style="rounded=0;html=1;fillColor=#e6f4f1;strokeColor=#0f766e;strokeWidth=1.5;fontColor=#1f2933;align=center;fontSize=12;whiteSpace=wrap;spacing=8;" vertex="1" parent="p4-1"><mxGeometry x="110" y="2460" width="520" height="100" as="geometry"/></mxCell>
        <mxCell id="m4" value="MÓDULO 4 — Nombre y datos del territorio" style="rounded=0;html=1;fillColor=#e6f4f1;strokeColor=#0f766e;strokeWidth=1.5;fontColor=#1f2933;align=center;fontSize=12;whiteSpace=wrap;spacing=8;" vertex="1" parent="p4-1"><mxGeometry x="110" y="2615" width="520" height="90" as="geometry"/></mxCell>
        <mxCell id="m5" value="MÓDULO 5 — Derecho y restricciones" style="rounded=0;html=1;fillColor=#e6f4f1;strokeColor=#0f766e;strokeWidth=1.5;fontColor=#1f2933;align=center;fontSize=12;whiteSpace=wrap;spacing=8;" vertex="1" parent="p4-1"><mxGeometry x="110" y="2760" width="520" height="90" as="geometry"/></mxCell>
        <mxCell id="m6" value="MÓDULO 6 — Uso del territorio" style="rounded=0;html=1;fillColor=#e6f4f1;strokeColor=#0f766e;strokeWidth=1.5;fontColor=#1f2933;align=center;fontSize=12;whiteSpace=wrap;spacing=8;" vertex="1" parent="p4-1"><mxGeometry x="110" y="2905" width="520" height="90" as="geometry"/></mxCell>
        <mxCell id="m7" value="MÓDULO 7 — Documentos legales" style="rounded=0;html=1;fillColor=#e6f4f1;strokeColor=#0f766e;strokeWidth=1.5;fontColor=#1f2933;align=center;fontSize=12;whiteSpace=wrap;spacing=8;" vertex="1" parent="p4-1"><mxGeometry x="110" y="3050" width="520" height="90" as="geometry"/></mxCell>
        <mxCell id="d7" value="¿Tiene un documento
        oficial del territorio?" style="rhombus;html=1;fillColor=#fdeee6;strokeColor=#d95926;strokeWidth=1.5;fontColor=#1f2933;fontSize=11;whiteSpace=wrap;" vertex="1" parent="p4-1"><mxGeometry x="110" y="3195" width="520" height="140" as="geometry"/></mxCell>
        <mxCell id="m7b" value="MÓDULO 7B — Sin documento
        registra que aún no tiene título oficial" style="rounded=0;html=1;fillColor=#e6f4f1;strokeColor=#0f766e;strokeWidth=1.5;fontColor=#1f2933;align=center;fontSize=12;whiteSpace=wrap;spacing=8;" vertex="1" parent="p4-1"><mxGeometry x="700" y="3200" width="480" height="100" as="geometry"/></mxCell>
        <mxCell id="m8" value="MÓDULO 8 — Fuente espacial / cartografía" style="rounded=0;html=1;fillColor=#e6f4f1;strokeColor=#0f766e;strokeWidth=1.5;fontColor=#1f2933;align=center;fontSize=12;whiteSpace=wrap;spacing=8;" vertex="1" parent="p4-1"><mxGeometry x="110" y="3405" width="520" height="90" as="geometry"/></mxCell>
        <mxCell id="m9" value="MÓDULO 9 — Validación comunitaria" style="rounded=0;html=1;fillColor=#e6f4f1;strokeColor=#0f766e;strokeWidth=1.5;fontColor=#1f2933;align=center;fontSize=12;whiteSpace=wrap;spacing=8;" vertex="1" parent="p4-1"><mxGeometry x="110" y="3550" width="520" height="90" as="geometry"/></mxCell>
        <mxCell id="cierre" value="CIERRE — guarda con verificación
        (si no hay conexión, entra a la cola offline — Capítulo 6)" style="rounded=0;html=1;fillColor=#e8f6ef;strokeColor=#199e70;strokeWidth=1.5;fontColor=#1f2933;align=center;fontSize=12;fontStyle=1;whiteSpace=wrap;spacing=8;" vertex="1" parent="p4-1"><mxGeometry x="110" y="3695" width="520" height="120" as="geometry"/></mxCell>
        <mxCell id="tcol" value="Territorio colectivo guardado ✅" style="rounded=1;arcSize=50;html=1;fillColor=#0f766e;strokeColor=#0f766e;fontColor=#ffffff;fontStyle=1;fontSize=12;whiteSpace=wrap;" vertex="1" parent="p4-1"><mxGeometry x="110" y="3870" width="520" height="70" as="geometry"/></mxCell>
