        <mxCell id="proveedor" value="Proveedor de Meta
        (@builderbot/provider-meta)
        recibe y envía los mensajes de WhatsApp" style="rounded=0;html=1;fillColor=#e6f4f1;strokeColor=#0f766e;strokeWidth=1.5;fontColor=#1f2933;align=center;fontSize=12;fontStyle=1;whiteSpace=wrap;spacing=8;" vertex="1" parent="p2-1"><mxGeometry x="100" y="180" width="340" height="120" as="geometry"/></mxCell>
        <mxCell id="motor" value="Motor de flujos (builderbot)
        25 flujos encadenados con gotoFlow() — uno por cada
        pregunta o grupo de preguntas" style="rounded=0;html=1;fillColor=#e6f4f1;strokeColor=#0f766e;strokeWidth=1.5;fontColor=#1f2933;align=center;fontSize=12;fontStyle=1;whiteSpace=wrap;spacing=8;" vertex="1" parent="p2-1"><mxGeometry x="500" y="180" width="500" height="120" as="geometry"/></mxCell>
        <mxCell id="estado" value="Estado de la conversación
        (MemoryDB — vive en memoria)
        se pierde si el proceso se reinicia a mitad de un registro" style="rounded=0;html=1;fillColor=#fdeee6;strokeColor=#d95926;strokeWidth=1.5;fontColor=#1f2933;align=center;fontSize=12;fontStyle=1;whiteSpace=wrap;spacing=8;" vertex="1" parent="p2-1"><mxGeometry x="1060" y="180" width="420" height="120" as="geometry"/></mxCell>
        <mxCell id="n31" value="Mientras conversa, el motor de flujos usa:" style="text;html=1;fontSize=16;fontStyle=1;fontColor=#1f2933;align=left;" vertex="1" parent="p2-1"><mxGeometry x="100" y="340" width="700" height="26" as="geometry"/></mxCell>
        <mxCell id="voz" value="Transcripción de voz
        guardarAudio() envía la nota a Groq Whisper
        y guarda el texto reconocido" style="rounded=0;html=1;fillColor=#f0ebfa;strokeColor=#7a5cc0;strokeWidth=1.5;fontColor=#1f2933;align=center;fontSize=12;whiteSpace=wrap;spacing=8;" vertex="1" parent="p2-1"><mxGeometry x="100" y="380" width="420" height="120" as="geometry"/></mxCell>
        <mxCell id="ubic" value="Ubicación por coordenadas
        obtenerUbicacion() consulta Nominatim para hallar
        departamento, municipio y vereda" style="rounded=0;html=1;fillColor=#f0ebfa;strokeColor=#7a5cc0;strokeWidth=1.5;fontColor=#1f2933;align=center;fontSize=12;whiteSpace=wrap;spacing=8;" vertex="1" parent="p2-1"><mxGeometry x="550" y="380" width="420" height="120" as="geometry"/></mxCell>
        <mxCell id="audios" value="Audios de las preguntas
        Preguntas/*.mp3 — generados una sola vez con Azure
        Speech (generar_audios_azure.mjs), no en cada conversación" style="rounded=0;html=1;fillColor=#f0ebfa;strokeColor=#7a5cc0;strokeWidth=1.5;fontColor=#1f2933;align=center;fontSize=12;whiteSpace=wrap;spacing=8;" vertex="1" parent="p2-1"><mxGeometry x="1000" y="380" width="420" height="120" as="geometry"/></mxCell>
        <mxCell id="fotos" value="Fotos opcionales
        se descargan del mensaje de WhatsApp y quedan
        en data/fotos/, asociadas al registro" style="rounded=0;html=1;fillColor=#e6f4f1;strokeColor=#0f766e;strokeWidth=1.5;fontColor=#1f2933;align=center;fontSize=12;whiteSpace=wrap;spacing=8;" vertex="1" parent="p2-1"><mxGeometry x="1450" y="380" width="420" height="120" as="geometry"/></mxCell>
        <mxCell id="n32" value="Al cerrar cada módulo, guarda lo capturado:" style="text;html=1;fontSize=16;fontStyle=1;fontColor=#1f2933;align=left;" vertex="1" parent="p2-1"><mxGeometry x="100" y="550" width="700" height="26" as="geometry"/></mxCell>
        <mxCell id="guardar" value="Guardar con respaldo
        saveToDatabaseSafe()" style="rounded=0;html=1;fillColor=#e8f6ef;strokeColor=#199e70;strokeWidth=1.5;fontColor=#1f2933;align=center;fontSize=12;fontStyle=1;whiteSpace=wrap;spacing=8;" vertex="1" parent="p2-1"><mxGeometry x="100" y="600" width="380" height="120" as="geometry"/></mxCell>
        <mxCell id="decision" value="¿PostgreSQL
        responde?" style="rhombus;html=1;fillColor=#fdeee6;strokeColor=#d95926;strokeWidth=1.5;fontColor=#1f2933;fontSize=11;whiteSpace=wrap;" vertex="1" parent="p2-1"><mxGeometry x="540" y="585" width="260" height="150" as="geometry"/></mxCell>
        <mxCell id="pg" value="PostgreSQL
        catastro_etnico" style="shape=cylinder3;html=1;boundedLbl=1;fillColor=#199e70;strokeColor=#199e70;fontColor=#ffffff;fontStyle=1;fontSize=12;whiteSpace=wrap;" vertex="1" parent="p2-1"><mxGeometry x="900" y="610" width="260" height="110" as="geometry"/></mxCell>
        <mxCell id="cola" value="Cola de respaldo
        SQLite (offline_queue.db) + copia legible
        en offline_backup.json" style="rounded=0;html=1;fillColor=#eef0f2;strokeColor=#5b6470;strokeWidth=1.5;fontColor=#1f2933;align=center;fontSize=12;whiteSpace=wrap;spacing=8;" vertex="1" parent="p2-1"><mxGeometry x="900" y="800" width="420" height="120" as="geometry"/></mxCell>
        <mxCell id="sync" value="Sincronizador
        syncOfflineQueue() revisa la cola cada 5 minutos
        y reintenta guardar en PostgreSQL" style="rounded=0;html=1;fillColor=#eef0f2;strokeColor=#5b6470;strokeWidth=1.5;fontColor=#1f2933;align=center;fontSize=12;fontStyle=1;whiteSpace=wrap;spacing=8;" vertex="1" parent="p2-1"><mxGeometry x="1400" y="800" width="420" height="120" as="geometry"/></mxCell>
        <mxCell id="n33" value="mensaje recibido" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;fontColor=#3a3f44;labelBackgroundColor=#ffffff;strokeColor=#0f766e;strokeWidth=1.6;endArrow=block;endFill=1;endSize=8;startArrow=block;startFill=1;startSize=8;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;jumpStyle=arc;jumpSize=8;" edge="1" parent="p2-1" source="proveedor" target="motor"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="n34" value="lee y guarda
        respuestas" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;fontColor=#3a3f44;labelBackgroundColor=#ffffff;strokeColor=#d95926;strokeWidth=1.6;endArrow=block;endFill=1;endSize=8;startArrow=block;startFill=1;startSize=8;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;jumpStyle=arc;jumpSize=8;" edge="1" parent="p2-1" source="motor" target="estado"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
