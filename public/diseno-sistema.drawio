  <diagram id="pag5" name="6 · Secuencia — guardar sin conexión">
    <mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1580" pageHeight="1010" math="0" shadow="0">
      <root>
        <mxCell id="p5-0"/>
        <mxCell id="p5-1" parent="p5-0"/>
        <mxCell id="n99" value="Qué pasa cuando no hay internet" style="text;html=1;fontSize=26;fontStyle=1;fontColor=#1f2933;align=left;" vertex="1" parent="p5-1"><mxGeometry x="60" y="30" width="1460" height="34" as="geometry"/></mxCell>
        <mxCell id="n100" value="El tiempo avanza hacia abajo. La persona sigue la conversación con normalidad — el respaldo ocurre en silencio, detrás de escena." style="text;html=1;whiteSpace=wrap;fontSize=13;fontColor=#5b6470;align=left;" vertex="1" parent="p5-1"><mxGeometry x="60" y="68" width="1460" height="40" as="geometry"/></mxCell>
        <mxCell id="motor" value="&lt;b&gt;Motor de flujos&lt;br&gt;(chatbot)&lt;/b&gt;" style="rounded=1;html=1;fillColor=#0f766e;strokeColor=#0f766e;fontColor=#ffffff;fontSize=12;whiteSpace=wrap;" vertex="1" parent="p5-1"><mxGeometry x="100" y="130" width="240" height="60" as="geometry"/></mxCell>
        <mxCell id="n101" style="endArrow=none;html=1;strokeColor=#0f766e;strokeWidth=1.5;dashed=1;" edge="1" parent="p5-1"><mxGeometry relative="1" as="geometry"><mxPoint x="220" y="190" as="sourcePoint"/><mxPoint x="220" y="900" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="pg" value="&lt;b&gt;PostgreSQL&lt;/b&gt;" style="rounded=1;html=1;fillColor=#199e70;strokeColor=#199e70;fontColor=#ffffff;fontSize=12;whiteSpace=wrap;" vertex="1" parent="p5-1"><mxGeometry x="530" y="130" width="240" height="60" as="geometry"/></mxCell>
        <mxCell id="n102" style="endArrow=none;html=1;strokeColor=#199e70;strokeWidth=1.5;dashed=1;" edge="1" parent="p5-1"><mxGeometry relative="1" as="geometry"><mxPoint x="650" y="190" as="sourcePoint"/><mxPoint x="650" y="900" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="sqlite" value="&lt;b&gt;SQLite&lt;br&gt;(cola local)&lt;/b&gt;" style="rounded=1;html=1;fillColor=#5b6470;strokeColor=#5b6470;fontColor=#ffffff;fontSize=12;whiteSpace=wrap;" vertex="1" parent="p5-1"><mxGeometry x="900" y="130" width="240" height="60" as="geometry"/></mxCell>
        <mxCell id="n103" style="endArrow=none;html=1;strokeColor=#5b6470;strokeWidth=1.5;dashed=1;" edge="1" parent="p5-1"><mxGeometry relative="1" as="geometry"><mxPoint x="1020" y="190" as="sourcePoint"/><mxPoint x="1020" y="900" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="sync" value="&lt;b&gt;Sincronizador&lt;br&gt;(cada 5 min)&lt;/b&gt;" style="rounded=1;html=1;fillColor=#5b6470;strokeColor=#5b6470;fontColor=#ffffff;fontSize=12;whiteSpace=wrap;" vertex="1" parent="p5-1"><mxGeometry x="1280" y="130" width="240" height="60" as="geometry"/></mxCell>
        <mxCell id="n104" style="endArrow=none;html=1;strokeColor=#5b6470;strokeWidth=1.5;dashed=1;" edge="1" parent="p5-1"><mxGeometry relative="1" as="geometry"><mxPoint x="1400" y="190" as="sourcePoint"/><mxPoint x="1400" y="900" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="n105" value="intenta guardar el registro (INSERT)" style="endArrow=block;endFill=1;html=1;fontSize=11;fontColor=#1f2933;labelBackgroundColor=#ffffff;strokeColor=#199e70;strokeWidth=1.8;verticalAlign=bottom;" edge="1" parent="p5-1"><mxGeometry relative="1" as="geometry"><mxPoint x="220" y="250" as="sourcePoint"/><mxPoint x="650" y="250" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="n106" value="❌ no responde (sin conexión)" style="endArrow=block;endFill=1;html=1;fontSize=11;fontColor=#1f2933;labelBackgroundColor=#ffffff;strokeColor=#d95926;strokeWidth=1.8;dashed=1;verticalAlign=bottom;" edge="1" parent="p5-1"><mxGeometry relative="1" as="geometry"><mxPoint x="650" y="310" as="sourcePoint"/><mxPoint x="220" y="310" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="n107" value="guarda en offline_queue.db&lt;br&gt;+ copia en offline_backup.json" style="endArrow=block;endFill=1;html=1;fontSize=11;fontColor=#1f2933;labelBackgroundColor=#ffffff;strokeColor=#5b6470;strokeWidth=1.8;verticalAlign=bottom;" edge="1" parent="p5-1"><mxGeometry relative="1" as="geometry"><mxPoint x="220" y="380" as="sourcePoint"/><mxPoint x="1020" y="380" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="n108" value="La conversación sigue igual: la persona recibe sus respuestas y confirmaciones sin notar la falla" style="rounded=1;html=1;fillColor=#e6f4f1;strokeColor=#0f766e;fontColor=#1f2933;fontStyle=2;fontSize=11;whiteSpace=wrap;align=center;" vertex="1" parent="p5-1"><mxGeometry x="140" y="440" width="700" height="46" as="geometry"/></mxCell>
        <mxCell id="n109" value="⏱  pasan hasta 5 minutos" style="rounded=1;html=1;fillColor=#fdeee6;strokeColor=#d95926;fontColor=#1f2933;fontStyle=2;fontSize=11;whiteSpace=wrap;align=center;" vertex="1" parent="p5-1"><mxGeometry x="900" y="530" width="620" height="44" as="geometry"/></mxCell>
        <mxCell id="n110" value="¿hay registros pendientes?" style="endArrow=block;endFill=1;html=1;fontSize=11;fontColor=#1f2933;labelBackgroundColor=#ffffff;strokeColor=#5b6470;strokeWidth=1.8;verticalAlign=bottom;" edge="1" parent="p5-1"><mxGeometry relative="1" as="geometry"><mxPoint x="1400" y="620" as="sourcePoint"/><mxPoint x="1020" y="620" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="n111" value="sí, 1 pendiente" style="endArrow=block;endFill=1;html=1;fontSize=11;fontColor=#1f2933;labelBackgroundColor=#ffffff;strokeColor=#5b6470;strokeWidth=1.8;dashed=1;verticalAlign=bottom;" edge="1" parent="p5-1"><mxGeometry relative="1" as="geometry"><mxPoint x="1020" y="680" as="sourcePoint"/><mxPoint x="1400" y="680" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="n112" value="reintenta el mismo INSERT" style="endArrow=block;endFill=1;html=1;fontSize=11;fontColor=#1f2933;labelBackgroundColor=#ffffff;strokeColor=#199e70;strokeWidth=1.8;verticalAlign=bottom;" edge="1" parent="p5-1"><mxGeometry relative="1" as="geometry"><mxPoint x="1400" y="750" as="sourcePoint"/><mxPoint x="650" y="750" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="n113" value="✅ guardado" style="endArrow=block;endFill=1;html=1;fontSize=11;fontColor=#1f2933;labelBackgroundColor=#ffffff;strokeColor=#199e70;strokeWidth=1.8;dashed=1;verticalAlign=bottom;" edge="1" parent="p5-1"><mxGeometry relative="1" as="geometry"><mxPoint x="650" y="810" as="sourcePoint"/><mxPoint x="1400" y="810" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="n114" value="si todavía falla, no pasa nada: se reintenta en el siguiente ciclo, 5 minutos después" style="rounded=1;html=1;fillColor=#fdeee6;strokeColor=#d95926;fontColor=#1f2933;fontStyle=2;fontSize=11;whiteSpace=wrap;align=center;" vertex="1" parent="p5-1"><mxGeometry x="820" y="880" width="700" height="46" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="pag6" name="7 · Secuencia — autenticación">
    <mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="1130" math="0" shadow="0">
      <root>
        <mxCell id="p6-0"/>
        <mxCell id="p6-1" parent="p6-0"/>
        <mxCell id="n115" value="Cómo entra Katherine al visor" style="text;html=1;fontSize=26;fontStyle=1;fontColor=#1f2933;align=left;" vertex="1" parent="p6-1"><mxGeometry x="60" y="30" width="1180" height="34" as="geometry"/></mxCell>
        <mxCell id="n116" value="El token que se firma al iniciar sesión es lo único que el visor vuelve a pedir en cada petición — no vuelve a preguntar la contraseña durante 8 horas." style="text;html=1;whiteSpace=wrap;fontSize=13;fontColor=#5b6470;align=left;" vertex="1" parent="p6-1"><mxGeometry x="60" y="68" width="1180" height="40" as="geometry"/></mxCell>
        <mxCell id="nav" value="&lt;b&gt;Navegador&lt;br&gt;(Katherine)&lt;/b&gt;" style="rounded=1;html=1;fillColor=#c0392b;strokeColor=#c0392b;fontColor=#ffffff;fontSize=12;whiteSpace=wrap;" vertex="1" parent="p6-1"><mxGeometry x="100" y="130" width="240" height="60" as="geometry"/></mxCell>
        <mxCell id="n117" style="endArrow=none;html=1;strokeColor=#c0392b;strokeWidth=1.5;dashed=1;" edge="1" parent="p6-1"><mxGeometry relative="1" as="geometry"><mxPoint x="220" y="190" as="sourcePoint"/><mxPoint x="220" y="980" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="geo" value="&lt;b&gt;Geovisor&lt;br&gt;(geovisor.ts)&lt;/b&gt;" style="rounded=1;html=1;fillColor=#2f6fb0;strokeColor=#2f6fb0;fontColor=#ffffff;fontSize=12;whiteSpace=wrap;" vertex="1" parent="p6-1"><mxGeometry x="530" y="130" width="240" height="60" as="geometry"/></mxCell>
        <mxCell id="n118" style="endArrow=none;html=1;strokeColor=#2f6fb0;strokeWidth=1.5;dashed=1;" edge="1" parent="p6-1"><mxGeometry relative="1" as="geometry"><mxPoint x="650" y="190" as="sourcePoint"/><mxPoint x="650" y="980" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="pg" value="&lt;b&gt;PostgreSQL&lt;/b&gt;" style="rounded=1;html=1;fillColor=#199e70;strokeColor=#199e70;fontColor=#ffffff;fontSize=12;whiteSpace=wrap;" vertex="1" parent="p6-1"><mxGeometry x="960" y="130" width="240" height="60" as="geometry"/></mxCell>
        <mxCell id="n119" style="endArrow=none;html=1;strokeColor=#199e70;strokeWidth=1.5;dashed=1;" edge="1" parent="p6-1"><mxGeometry relative="1" as="geometry"><mxPoint x="1080" y="190" as="sourcePoint"/><mxPoint x="1080" y="980" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="n120" value="POST /auth/login  { usuario, contraseña }" style="endArrow=block;endFill=1;html=1;fontSize=11;fontColor=#1f2933;labelBackgroundColor=#ffffff;strokeColor=#c0392b;strokeWidth=1.8;verticalAlign=bottom;" edge="1" parent="p6-1"><mxGeometry relative="1" as="geometry"><mxPoint x="220" y="250" as="sourcePoint"/><mxPoint x="650" y="250" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="n121" value="SELECT ... FROM geovisor_users" style="endArrow=block;endFill=1;html=1;fontSize=11;fontColor=#1f2933;labelBackgroundColor=#ffffff;strokeColor=#199e70;strokeWidth=1.8;verticalAlign=bottom;" edge="1" parent="p6-1"><mxGeometry relative="1" as="geometry"><mxPoint x="650" y="310" as="sourcePoint"/><mxPoint x="1080" y="310" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="n122" value="fila con password_hash" style="endArrow=block;endFill=1;html=1;fontSize=11;fontColor=#1f2933;labelBackgroundColor=#ffffff;strokeColor=#199e70;strokeWidth=1.8;dashed=1;verticalAlign=bottom;" edge="1" parent="p6-1"><mxGeometry relative="1" as="geometry"><mxPoint x="1080" y="370" as="sourcePoint"/><mxPoint x="650" y="370" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="n123" value="bcrypt.compare(contraseña, hash)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;fontColor=#3a3f44;labelBackgroundColor=#ffffff;strokeColor=#2f6fb0;strokeWidth=1.6;endArrow=block;endFill=1;exitX=1;exitY=0;entryX=1;entryY=1;" edge="1" parent="p6-1"><mxGeometry relative="1" as="geometry"><mxPoint x="650" y="440" as="sourcePoint"/><mxPoint x="650" y="490" as="targetPoint"/><Array as="points"><mxPoint x="870" y="440"/><mxPoint x="870" y="490"/></Array></mxGeometry></mxCell>
        <mxCell id="n124" value="jwt.sign({ id, usuario, rol }, secreto, 8h)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;fontColor=#3a3f44;labelBackgroundColor=#ffffff;strokeColor=#2f6fb0;strokeWidth=1.6;endArrow=block;endFill=1;exitX=1;exitY=0;entryX=1;entryY=1;" edge="1" parent="p6-1"><mxGeometry relative="1" as="geometry"><mxPoint x="650" y="520" as="sourcePoint"/><mxPoint x="650" y="570" as="targetPoint"/><Array as="points"><mxPoint x="870" y="520"/><mxPoint x="870" y="570"/></Array></mxGeometry></mxCell>
        <mxCell id="n125" value="200 OK  { token }" style="endArrow=block;endFill=1;html=1;fontSize=11;fontColor=#1f2933;labelBackgroundColor=#ffffff;strokeColor=#2f6fb0;strokeWidth=1.8;verticalAlign=bottom;" edge="1" parent="p6-1"><mxGeometry relative="1" as="geometry"><mxPoint x="650" y="600" as="sourcePoint"/><mxPoint x="220" y="600" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="n126" value="el navegador guarda el token y lo envía en cada petición siguiente" style="rounded=1;html=1;fillColor=#fbeae8;strokeColor=#c0392b;fontColor=#1f2933;fontStyle=2;fontSize=11;whiteSpace=wrap;align=center;" vertex="1" parent="p6-1"><mxGeometry x="140" y="660" width="900" height="46" as="geometry"/></mxCell>
        <mxCell id="n127" value="GET /api/registros&lt;br&gt;Authorization: Bearer &lt;token&gt;" style="endArrow=block;endFill=1;html=1;fontSize=11;fontColor=#1f2933;labelBackgroundColor=#ffffff;strokeColor=#c0392b;strokeWidth=1.8;verticalAlign=bottom;" edge="1" parent="p6-1"><mxGeometry relative="1" as="geometry"><mxPoint x="220" y="750" as="sourcePoint"/><mxPoint x="650" y="750" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="n128" value="authMiddleware: jwt.verify(token)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;fontColor=#3a3f44;labelBackgroundColor=#ffffff;strokeColor=#d95926;strokeWidth=1.6;endArrow=block;endFill=1;exitX=1;exitY=0;entryX=1;entryY=1;" edge="1" parent="p6-1"><mxGeometry relative="1" as="geometry"><mxPoint x="650" y="820" as="sourcePoint"/><mxPoint x="650" y="870" as="targetPoint"/><Array as="points"><mxPoint x="870" y="820"/><mxPoint x="870" y="870"/></Array></mxGeometry></mxCell>
