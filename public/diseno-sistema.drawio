  <diagram id="pag9" name="10 · El modelo de datos, en simple">
    <mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1840" pageHeight="1060" math="0" shadow="0">
      <root>
        <mxCell id="p9-0"/>
        <mxCell id="p9-1" parent="p9-0"/>
        <mxCell id="n163" value="De qué está hecho el territorio: el modelo de datos, en simple" style="text;html=1;fontSize=26;fontStyle=1;fontColor=#1f2933;align=left;" vertex="1" parent="p9-1"><mxGeometry x="60" y="30" width="1780" height="34" as="geometry"/></mxCell>
        <mxCell id="n164" value="Este resumen usa los tres conceptos del estándar LADM-COL (ISO 19152). El detalle completo — cada tabla, cada columna — está en los anexos: diagrama-chen.drawio y DICCIONARIO_BD.md." style="text;html=1;whiteSpace=wrap;fontSize=13;fontColor=#5b6470;align=left;" vertex="1" parent="p9-1"><mxGeometry x="60" y="68" width="1780" height="40" as="geometry"/></mxCell>
        <mxCell id="interesado" value="&lt;b&gt;INTERESADO — ¿quién?&lt;/b&gt;&lt;br&gt;&lt;br&gt;la comunidad étnica (colectivo),&lt;br&gt;sus familias,&lt;br&gt;su representante legal" style="rounded=0;html=1;fillColor=#fbeae8;strokeColor=#c0392b;strokeWidth=1.5;fontColor=#1f2933;align=left;fontSize=12;whiteSpace=wrap;spacing=8;" vertex="1" parent="p9-1"><mxGeometry x="120" y="400" width="400" height="170" as="geometry"/></mxCell>
        <mxCell id="derecho" value="&lt;b&gt;DERECHO — ¿con qué derecho?&lt;/b&gt;&lt;br&gt;&lt;br&gt;propiedad colectiva del territorio,&lt;br&gt;con sus restricciones&lt;br&gt;(ej. reserva forestal)" style="rounded=0;html=1;fillColor=#fdeee6;strokeColor=#d95926;strokeWidth=1.5;fontColor=#1f2933;align=left;fontSize=12;whiteSpace=wrap;spacing=8;" vertex="1" parent="p9-1"><mxGeometry x="800" y="180" width="400" height="170" as="geometry"/></mxCell>
        <mxCell id="unidad" value="&lt;b&gt;UNIDAD ESPACIAL — ¿dónde?&lt;/b&gt;&lt;br&gt;&lt;br&gt;el territorio de propiedad colectiva&lt;br&gt;y sus predios,&lt;br&gt;con su perímetro" style="rounded=0;html=1;fillColor=#eaf1fa;strokeColor=#2f6fb0;strokeWidth=1.5;fontColor=#1f2933;align=left;fontSize=12;whiteSpace=wrap;spacing=8;" vertex="1" parent="p9-1"><mxGeometry x="800" y="620" width="400" height="170" as="geometry"/></mxCell>
        <mxCell id="n165" value="es titular de" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;fontColor=#3a3f44;labelBackgroundColor=#ffffff;strokeColor=#c0392b;strokeWidth=1.6;endArrow=block;endFill=1;endSize=8;jumpStyle=arc;jumpSize=8;" edge="1" parent="p9-1" source="interesado" target="derecho"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="n166" value="recae sobre" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;fontColor=#3a3f44;labelBackgroundColor=#ffffff;strokeColor=#d95926;strokeWidth=1.6;endArrow=block;endFill=1;endSize=8;jumpStyle=arc;jumpSize=8;" edge="1" parent="p9-1" source="derecho" target="unidad"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="fuente" value="Todo debe estar sustentado en una fuente:
        un acta o resolución,
        o coordenadas GPS levantadas en campo" style="shape=parallelogram;html=1;fillColor=#eef0f2;strokeColor=#5b6470;fontColor=#1f2933;fontSize=11;whiteSpace=wrap;" vertex="1" parent="p9-1"><mxGeometry x="560" y="850" width="380" height="130" as="geometry"/></mxCell>
        <mxCell id="n167" value="lo sustenta" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;fontColor=#3a3f44;labelBackgroundColor=#ffffff;strokeColor=#5b6470;strokeWidth=1.6;endArrow=block;endFill=1;endSize=8;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.85;entryDx=0;entryDy=0;jumpStyle=arc;jumpSize=8;" edge="1" parent="p9-1" source="fuente" target="derecho"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="750" y="325"/></Array></mxGeometry></mxCell>
        <mxCell id="n168" value="lo sustenta" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;fontColor=#3a3f44;labelBackgroundColor=#ffffff;strokeColor=#5b6470;strokeWidth=1.6;endArrow=block;endFill=1;endSize=8;dashed=1;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0.3;entryY=1;entryDx=0;entryDy=0;jumpStyle=arc;jumpSize=8;" edge="1" parent="p9-1" source="fuente" target="unidad"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="extensiones" value="&lt;b&gt;Además [EXT]&lt;/b&gt;&lt;br&gt;&lt;br&gt;información que el estándar no cubre,&lt;br&gt;añadida por este proyecto:&lt;br&gt;fotos, historia del territorio,&lt;br&gt;uso del territorio, validación&lt;br&gt;comunitaria, dirección" style="rounded=0;html=1;fillColor=#f0ebfa;strokeColor=#7a5cc0;strokeWidth=1.5;fontColor=#1f2933;align=left;fontSize=12;whiteSpace=wrap;spacing=8;" vertex="1" parent="p9-1"><mxGeometry x="1320" y="620" width="420" height="190" as="geometry"/></mxCell>
        <mxCell id="n169" value="se registran junto con" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;fontColor=#3a3f44;labelBackgroundColor=#ffffff;strokeColor=#7a5cc0;strokeWidth=1.6;endArrow=block;endFill=1;endSize=8;jumpStyle=arc;jumpSize=8;" edge="1" parent="p9-1" source="unidad" target="extensiones"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="catalogos" value="Cada &quot;tipo de...&quot; (derecho, restricción, fuente, etc.) sale de una tabla de catálogo con los valores del estándar más los que añadió el proyecto, marcados [EXT] (Capítulo del modelo de datos, anexo DICCIONARIO_BD.md)." style="shape=note;size=14;html=1;fillColor=#fdeee6;strokeColor=#d95926;fontColor=#1f2933;fontSize=10;whiteSpace=wrap;align=left;spacing=6;" vertex="1" parent="p9-1"><mxGeometry x="1320" y="180" width="420" height="170" as="geometry"/></mxCell>
        <mxCell id="n170" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;fontColor=#3a3f44;labelBackgroundColor=#ffffff;strokeColor=#d95926;strokeWidth=1.6;endArrow=block;endFill=1;endSize=8;dashed=1;jumpStyle=arc;jumpSize=8;" edge="1" parent="p9-1" source="derecho" target="catalogos"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
