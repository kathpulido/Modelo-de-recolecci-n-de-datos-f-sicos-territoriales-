  <diagram id="pag3" name="4 · Componentes del geovisor">
    <mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1150" math="0" shadow="0">
      <root>
        <mxCell id="p3-0"/>
        <mxCell id="p3-1" parent="p3-0"/>
        <mxCell id="n45" value="Por dentro del visor: geovisor.ts" style="text;html=1;fontSize=26;fontStyle=1;fontColor=#1f2933;align=left;" vertex="1" parent="p3-1"><mxGeometry x="60" y="30" width="1600" height="34" as="geometry"/></mxCell>
        <mxCell id="n46" value="Un servidor Express con 24 rutas HTTP, agrupadas aquí por lo que hacen. Casi todas exigen el mismo control de acceso antes de responder." style="text;html=1;whiteSpace=wrap;fontSize=13;fontColor=#5b6470;align=left;" vertex="1" parent="p3-1"><mxGeometry x="60" y="68" width="1900" height="40" as="geometry"/></mxCell>
        <mxCell id="marco" value="" style="rounded=1;html=1;fillColor=none;strokeColor=#5b6470;strokeWidth=1.5;dashed=1;verticalAlign=top;fontColor=#5b6470;" vertex="1" parent="p3-1"><mxGeometry x="50" y="130" width="1900" height="1000" as="geometry"/></mxCell>
        <mxCell id="n47" value="geovisor.ts — el proceso del visor (puerto 3009)" style="text;html=1;fontSize=13;fontStyle=1;fontColor=#5b6470;align=left;spacingLeft=10;" vertex="1" parent="p3-1"><mxGeometry x="58" y="108" width="1884" height="20" as="geometry"/></mxCell>
        <mxCell id="nav" value="Navegador
        (Katherine)" style="shape=actor;html=1;fillColor=#fbeae8;strokeColor=#c0392b;strokeWidth=1.5;fontColor=#1f2933;fontStyle=1;fontSize=12;whiteSpace=wrap;verticalLabelPosition=bottom;verticalAlign=top;labelPosition=center;" vertex="1" parent="p3-1"><mxGeometry x="130" y="175" width="220" height="100" as="geometry"/></mxCell>
        <mxCell id="login" value="POST /auth/login
        PUT /auth/password
        (usuario + contraseña con bcrypt → token)" style="rounded=0;html=1;fillColor=#eaf1fa;strokeColor=#2f6fb0;strokeWidth=1.5;fontColor=#1f2933;align=center;fontSize=12;fontStyle=1;whiteSpace=wrap;spacing=8;" vertex="1" parent="p3-1"><mxGeometry x="420" y="180" width="380" height="110" as="geometry"/></mxCell>
        <mxCell id="gate" value="authMiddleware
        ¿token JWT
        válido?" style="rhombus;html=1;fillColor=#fdeee6;strokeColor=#d95926;strokeWidth=1.5;fontColor=#1f2933;fontSize=11;whiteSpace=wrap;" vertex="1" parent="p3-1"><mxGeometry x="900" y="165" width="260" height="140" as="geometry"/></mxCell>
        <mxCell id="rechazo" value="401 Acceso no autorizado
        si falta el token o venció
        (dura 8 horas)" style="shape=note;size=14;html=1;fillColor=#fdeee6;strokeColor=#d95926;fontColor=#1f2933;fontSize=10;whiteSpace=wrap;align=left;spacing=6;" vertex="1" parent="p3-1"><mxGeometry x="1240" y="190" width="300" height="90" as="geometry"/></mxCell>
        <mxCell id="mapa" value="&lt;b&gt;Datos del mapa&lt;/b&gt;&lt;br&gt;&lt;br&gt;GET /api/puntos&lt;br&gt;GET /api/parcelas&lt;br&gt;GET /api/capas&lt;br&gt;GET /api/config" style="rounded=0;html=1;fillColor=#eaf1fa;strokeColor=#2f6fb0;strokeWidth=1.5;fontColor=#1f2933;align=left;fontSize=12;whiteSpace=wrap;spacing=8;" vertex="1" parent="p3-1"><mxGeometry x="100" y="400" width="420" height="190" as="geometry"/></mxCell>
        <mxCell id="registros" value="&lt;b&gt;Consulta de registros&lt;/b&gt;&lt;br&gt;&lt;br&gt;GET /api/registros&lt;br&gt;GET /api/registro/:id&lt;br&gt;GET /api/foto/:id" style="rounded=0;html=1;fillColor=#eaf1fa;strokeColor=#2f6fb0;strokeWidth=1.5;fontColor=#1f2933;align=left;fontSize=12;whiteSpace=wrap;spacing=8;" vertex="1" parent="p3-1"><mxGeometry x="560" y="400" width="420" height="190" as="geometry"/></mxCell>
        <mxCell id="analisis" value="&lt;b&gt;Análisis&lt;/b&gt;&lt;br&gt;&lt;br&gt;GET /api/analisis/areas&lt;br&gt;GET /api/analisis/traslapes&lt;br&gt;GET /api/analisis/densidad&lt;br&gt;GET /api/estadisticas&lt;br&gt;GET /api/alertas" style="rounded=0;html=1;fillColor=#eaf1fa;strokeColor=#2f6fb0;strokeWidth=1.5;fontColor=#1f2933;align=left;fontSize=12;whiteSpace=wrap;spacing=8;" vertex="1" parent="p3-1"><mxGeometry x="1020" y="400" width="420" height="190" as="geometry"/></mxCell>
        <mxCell id="export" value="&lt;b&gt;Exportación&lt;/b&gt;&lt;br&gt;&lt;br&gt;GET /api/export/csv&lt;br&gt;GET /api/export/pdf (puppeteer)&lt;br&gt;GET /api/export/excel (exceljs)" style="rounded=0;html=1;fillColor=#eaf1fa;strokeColor=#2f6fb0;strokeWidth=1.5;fontColor=#1f2933;align=left;fontSize=12;whiteSpace=wrap;spacing=8;" vertex="1" parent="p3-1"><mxGeometry x="1480" y="400" width="420" height="190" as="geometry"/></mxCell>
        <mxCell id="admin" value="&lt;b&gt;Administración (solo rol admin)&lt;/b&gt;&lt;br&gt;&lt;br&gt;GET/POST /api/usuarios&lt;br&gt;PUT /api/usuarios/:id&lt;br&gt;POST /api/chatbot/mensaje&lt;br&gt;GET /api/opciones" style="rounded=0;html=1;fillColor=#fdeee6;strokeColor=#d95926;strokeWidth=1.5;fontColor=#1f2933;align=left;fontSize=12;whiteSpace=wrap;spacing=8;" vertex="1" parent="p3-1"><mxGeometry x="100" y="640" width="420" height="190" as="geometry"/></mxCell>
        <mxCell id="pg" value="PostgreSQL + PostGIS
        (vista_predio_colectivo y demás vistas)" style="shape=cylinder3;html=1;boundedLbl=1;fillColor=#199e70;strokeColor=#199e70;fontColor=#ffffff;fontStyle=1;fontSize=12;whiteSpace=wrap;" vertex="1" parent="p3-1"><mxGeometry x="900" y="900" width="340" height="130" as="geometry"/></mxCell>
        <mxCell id="n48" value="entra con usuario y contraseña" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;fontColor=#3a3f44;labelBackgroundColor=#ffffff;strokeColor=#c0392b;strokeWidth=1.6;endArrow=block;endFill=1;endSize=8;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.7;entryDx=0;entryDy=0;jumpStyle=arc;jumpSize=8;" edge="1" parent="p3-1" source="nav" target="login"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="n49" value="firma el token (8 h)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;fontColor=#3a3f44;labelBackgroundColor=#ffffff;strokeColor=#2f6fb0;strokeWidth=1.6;endArrow=block;endFill=1;endSize=8;jumpStyle=arc;jumpSize=8;" edge="1" parent="p3-1" source="login" target="gate"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="n50" value="cada petición /api/... trae el token" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;fontColor=#3a3f44;labelBackgroundColor=#ffffff;strokeColor=#c0392b;strokeWidth=1.6;endArrow=block;endFill=1;endSize=8;exitX=1;exitY=0.15;exitDx=0;exitDy=0;entryX=0;entryY=0.2;entryDx=0;entryDy=0;jumpStyle=arc;jumpSize=8;" edge="1" parent="p3-1" source="nav" target="gate"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="310" y="155"/><mxPoint x="900" y="155"/></Array></mxGeometry></mxCell>
        <mxCell id="n51" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;fontColor=#3a3f44;labelBackgroundColor=#ffffff;strokeColor=#d95926;strokeWidth=1.6;endArrow=block;endFill=1;endSize=8;jumpStyle=arc;jumpSize=8;" edge="1" parent="p3-1" source="gate" target="rechazo"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="n52" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;fontColor=#3a3f44;labelBackgroundColor=#ffffff;strokeColor=#2f6fb0;strokeWidth=1.6;endArrow=block;endFill=1;endSize=8;jumpStyle=arc;jumpSize=8;" edge="1" parent="p3-1" source="gate" target="mapa"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="n53" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;fontColor=#3a3f44;labelBackgroundColor=#ffffff;strokeColor=#2f6fb0;strokeWidth=1.6;endArrow=block;endFill=1;endSize=8;jumpStyle=arc;jumpSize=8;" edge="1" parent="p3-1" source="gate" target="registros"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="n54" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;fontColor=#3a3f44;labelBackgroundColor=#ffffff;strokeColor=#2f6fb0;strokeWidth=1.6;endArrow=block;endFill=1;endSize=8;jumpStyle=arc;jumpSize=8;" edge="1" parent="p3-1" source="gate" target="analisis"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="n55" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;fontColor=#3a3f44;labelBackgroundColor=#ffffff;strokeColor=#2f6fb0;strokeWidth=1.6;endArrow=block;endFill=1;endSize=8;jumpStyle=arc;jumpSize=8;" edge="1" parent="p3-1" source="gate" target="export"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="n56" value="sí, y además rol = admin" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;fontColor=#3a3f44;labelBackgroundColor=#ffffff;strokeColor=#d95926;strokeWidth=1.6;endArrow=block;endFill=1;endSize=8;exitX=0;exitY=0.85;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;jumpStyle=arc;jumpSize=8;" edge="1" parent="p3-1" source="gate" target="admin"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="72" y="330"/><mxPoint x="72" y="735"/></Array></mxGeometry></mxCell>
        <mxCell id="n57" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;fontColor=#3a3f44;labelBackgroundColor=#ffffff;strokeColor=#199e70;strokeWidth=1.6;endArrow=block;endFill=1;endSize=8;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;jumpStyle=arc;jumpSize=8;" edge="1" parent="p3-1" source="mapa" target="pg"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="n58" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;fontColor=#3a3f44;labelBackgroundColor=#ffffff;strokeColor=#199e70;strokeWidth=1.6;endArrow=block;endFill=1;endSize=8;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;jumpStyle=arc;jumpSize=8;" edge="1" parent="p3-1" source="registros" target="pg"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="n59" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;fontColor=#3a3f44;labelBackgroundColor=#ffffff;strokeColor=#199e70;strokeWidth=1.6;endArrow=block;endFill=1;endSize=8;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;jumpStyle=arc;jumpSize=8;" edge="1" parent="p3-1" source="analisis" target="pg"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
