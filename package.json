  "main": "dist/app.js",
  "type": "module",
  "scripts": {
    "start": "node ./dist/app.js",
    "lint": "eslint . --no-ignore",
    "dev": "npm run lint && nodemon --signal SIGKILL ./src/app.ts",
    "build": "npx rollup -c",
    "geovisor": "tsx src/geovisor.ts",
    "geovisor:publico": "node ./scripts/publicar-visor.mjs",
    "dev:geovisor": "nodemon --signal SIGKILL --watch src/geovisor.ts --exec tsx src/geovisor.ts",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:geovisor\"",
    "start:all": "node ./scripts/start-all.mjs"
  },
  "keywords": [],
  "dependencies": {
    "@builderbot/bot": "^1.4.2",
    "@builderbot/database-postgres": "^1.4.2",
