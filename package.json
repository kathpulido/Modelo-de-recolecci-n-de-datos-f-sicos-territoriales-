    "eslint-plugin-builderbot": "latest",
    "nodemon": "^3.1.11",
    "prettier": "^3.8.1",
    "rollup": "^4.10.0",
    "rollup-plugin-typescript2": "^0.36.0",
    "tsx": "^4.7.1",
    "typescript": "^5.4.3",
    "typescript-eslint": "^8.0.0"
  },
